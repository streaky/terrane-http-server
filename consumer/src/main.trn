namespace http-server-consumer

from /terrane/annotation-consumer-protocol import get, at, text, truth, scalar, annotation, read-request, emit-source, emit-error, error-origin, consumer-error
from /core/collections import list, range, map
from /core/documents import document-value, document-map-entries, make-document-none, make-document-string, make-document-bool, make-document-integer
from /core/errors import replace-error
from /http-server-consumer/rendering import make-code-engine, render-code
from /streaky/template import template-engine, template-value, text-value, bool-value, list-value as template-list-value, object-value as template-object-value
from /http-server-consumer/documents import object-value, list-value, encode-document, type-schema, source-quote, operation-documentation, declaration-documentation
from /http-server-consumer/models import is-model, model-reference, model-schemas, model-codecs, model-encoder, model-decoder
from /http-server-consumer/examples import declaration-examples
from /http-server-consumer/formats import read-response-policy, format-list-source, xml-response-schema, format-media-type
from /http-server-consumer/overview import api-info

function template-operations list of template-value throws consumer-error; operations list of operation, owner string
    values list of template-value = list
    for index in (range; 0, operations.length)
        item = operations[index]
        fields map of string, template-value = map;
        fields.set; 'index', (text-value; (index.to-string;))
        fields.set; 'method-key', (text-value; (method-key; item.method, (make-document-none;)))
        fields.set; 'path-source', (text-value; (source-quote; item.path))
        fields.set; 'adapter', (text-value; item.adapter)
        fields.set; 'selected', (bool-value; item.owner == owner)
        values.append; (template-object-value; fields)
    return values

function controller-source string throws consumer-error; engine ref template-engine, name string, owner string, source-type string, operations list of operation, documented bool
    values map of string, template-value = map;
    values.set; 'name', (text-value; name)
    values.set; 'owner', (bool-value; owner != '')
    values.set; 'source-type', (text-value; source-type)
    values.set; 'operations', (template-list-value; (template-operations; operations, owner))
    values.set; 'documented', (bool-value; documented)
    return render-code; ref engine, 'http/controller-source.trn.tpl', values

class operation
    path string
    method string
    identity string
    schema document-value
    adapter string
    owner string
    mounted-path string
    documented bool

    function construct; path string, method string, identity string, schema document-value, adapter string, owner string = '', mounted-path string = '', documented bool = true
        this.path = path
        this.method = method
        this.identity = identity
        this.schema = schema
        this.adapter = adapter
        this.owner = owner
        this.mounted-path = mounted-path
        this.documented = documented

function fail; declaration document-value, message string
    throw (instance consumer-error; declaration, message)

function metadata-string string throws consumer-error; metadata document-value, key string, record document-value
    value = scalar; (get; metadata, key)
    if value.kind != 'string'
        fail; record, ('HTTP metadata field ' + key + ' must be a string')
    return text; value

function parameter-record document-value throws consumer-error; declarations document-value, identity string, name string, parent document-value
    wanted = identity + '::' + name
    result = make-document-none;
    count int = 0
    for index in (range; 0, (declarations.length;))
        record = at; declarations, index
        if (text; (get; record, 'kind')) == 'parameter' and (text; (get; record, 'identity')) == wanted
            result = record
            count = count + 1
    if count != 1
        fail; parent, ('handler parameter ' + (source-quote; wanted) + ' must have exactly one selected declaration record')
    return result

function method-key string throws consumer-error; value string, record document-value
    switch value
        case 'GET'
            return 'get'
        case 'POST'
            return 'post'
        case 'PUT'
            return 'put'
        case 'PATCH'
            return 'patch'
        case 'DELETE'
            return 'delete'
    throw (instance consumer-error; record, 'HTTP method must be GET, POST, PUT, PATCH, or DELETE')

function schema-type string; kind string
    if kind == 'int'
        return 'integer'
    if kind == 'bool'
        return 'boolean'
    return kind

function is-document bool; name string
    return name == 'document-value' or name == '/core/documents::document-value'

function route-shape string throws consumer-error; path string, record document-value
    if not (path.contains.start; '/') or (path.contains; '?') or (path.contains; '#') or (path.contains; '*') or (path.contains; ':')
        fail; record, 'HTTP path must be absolute, without query, fragment, wildcard, or colon syntax'
    shape string = ''
    segments = path.split; '/'
    for segment in segments
        if (segment.contains; '{') or (segment.contains; '}')
            if not (segment.contains.start; '{') or not (segment.contains.end; '}') or segment.length < 3
                fail; record, 'path placeholders must occupy a complete nonempty segment'
            name = segment.replace; (list; '{', '}'), ''
            if segment != ('{' + name + '}')
                fail; record, 'malformed path placeholder'
            shape = shape + '/{}'
        else
            shape = shape + '/' + segment
    return shape

function default-source string throws consumer-error; value document-value, kind string, record document-value
    actual = text; (get; value, 'kind')
    expected = kind
    if kind == 'int'
        expected = 'integer'
    else if kind == 'bool'
        expected = 'boolean'
    if actual != expected
        fail; record, 'HTTP query default must be a compile-time scalar of its declared type'
    raw = scalar; value
    if kind == 'string'
        return source-quote; (text; raw)
    return text; raw

function default-json document-value throws consumer-error; value document-value, kind string, record document-value
    default-source; value, kind, record
    raw = scalar; value
    if kind == 'string'
        return make-document-string; (text; raw)
    if kind == 'int'
        result = make-document-integer; (text; raw)
        if result.failed
            fail; record, result.message
        return result.value
    return make-document-bool; (text; raw) == 'true'

function response-description document-value throws consumer-error; description string, origin document-value
    entries = instance document-map-entries;
    entries.append; 'description', (make-document-string; description)
    return (object-value; entries, origin)

function response-with-content document-value throws consumer-error; description string, content document-value, origin document-value
    entries = instance document-map-entries;
    entries.append; 'description', (make-document-string; description)
    entries.append; 'content', content
    return (object-value; entries, origin)

function route-group-record document-value throws consumer-error; declarations document-value, identity string, declaration document-value
    for index in (range; 0, (declarations.length;))
        record = at; declarations, index
        if (text; (get; record, 'identity')) == identity and (text; (get; record, 'kind')) == 'class'
            metadata = annotation; record, 'route-group', '/streaky/http-server/annotations'
            if metadata.kind == 'none'
                fail; record, 'HTTP endpoint method requires route-group metadata on its selected class'
            return record
    fail; declaration, 'HTTP endpoint method requires its selected class declaration'
    return make-document-none;

function make-operation operation throws consumer-error; declaration document-value, declarations document-value, index int
    metadata = annotation; declaration, 'endpoint', '/streaky/http-server/annotations'
    path = metadata-string; metadata, 'path', declaration
    method = metadata-string; metadata, 'method', declaration
    method-key; method, declaration
    route-shape; path, declaration
    if path == '/openapi.json'
        fail; declaration, '/openapi.json is reserved for the generated OpenAPI document'
    signature = get; declaration, 'signature'
    identity = text; (get; declaration, 'identity')
    pieces = identity.split; '::'
    owner string = ''
    prefix string = '/'
    documented bool = true
    target = 'selected-handler' + index
    group-policy = make-document-none;
    if pieces.length == 3
        owner = pieces[0] + '::' + pieces[1]
        group = route-group-record; declarations, owner, declaration
        group-meta = annotation; group, 'route-group', '/streaky/http-server/annotations'
        group-policy = group-meta
        prefix = metadata-string; group-meta, 'prefix', group
        route-shape; prefix, group
        if prefix != '/' and (prefix.contains.end; '/')
            fail; group, 'HTTP route-group prefix must not have a trailing slash'
        documented = truth; (scalar; (get; group-meta, 'document'))
        target = 'this.source.' + pieces[2]
    else if pieces.length != 2
        fail; declaration, 'HTTP handler must be a standalone function or a selected class method'
    if not (truth; (get; signature, 'async')) or (truth; (get; signature, 'unsafe')) or (truth; (get; signature, 'static'))
        fail; declaration, 'HTTP handler must be a safe asynchronous function or shared class method'
    contracts = get; declaration, 'contracts'
    if owner != '' and (text; (get; contracts, 'invocation_mode')) != 'Shared'
        fail; declaration, 'HTTP endpoint methods must have shared invocation authority'
    result-kind = text; (get; signature, 'result')
    result-explicit = result-kind == 'http-response' or result-kind == '/streaky/http-server::http-response'
    result-document = is-document; result-kind
    result-model = false
    if not result-explicit
        result-model = is-model; result-kind, declarations
    if result-kind != 'string' and result-kind != 'int' and result-kind != 'bool' and not result-document and not result-model and not result-explicit
        fail; declaration, 'HTTP result must be a scalar, document-value, http-response, or a selected Terrane model class'
    content-type = metadata-string; metadata, 'content-type', declaration
    if content-type != 'application/json' and content-type != 'text/html' and content-type != 'text/plain'
        fail; declaration, 'HTTP response content-type must be application/json, text/html, or text/plain'
    if not result-explicit and content-type != 'application/json' and result-kind != 'string'
        fail; declaration, 'HTML and plain-text endpoints must return string'
    policy = read-response-policy; group-policy, declaration
    structured = not result-explicit and content-type == 'application/json'
    operation-id = metadata-string; metadata, 'operation-id', declaration
    if operation-id == ''
        try
            # Escape '_' first: ordered replacements must not re-escape later escape prefixes.
            operation-id = identity.replace; (list; '_', '/', ':'), (list; '_5f', '_2f', '_3a')
        catch replace-error
            fail; declaration, 'HTTP operation identity escape table has unequal search/replacement counts'
        operation-id = 'operation' + operation-id
    summary = metadata-string; metadata, 'summary', declaration
    description = metadata-string; metadata, 'description', declaration
    if description == ''
        description = operation-documentation; declaration, false
    entries = instance document-map-entries;
    entries.append; 'operationId', (make-document-string; operation-id)
    entries.append; 'summary', (make-document-string; summary)
    entries.append; 'description', (make-document-string; description)
    parameter-values list of document-value = list
    adapter = '    async function adapt-handler' + index + ' http-response throws throwable; request http-request\n'
    arguments string = ''
    parameters = get; signature, 'parameters'
    if parameters.kind != 'list'
        fail; declaration, 'HTTP handler signature must expose parameters'
    if (parameters.length;) == 0
        adapter = '    async function adapt-handler' + index + ' http-response throws throwable; _request http-request\n'
    if structured
        adapter = '    async function adapt-handler' + index + ' http-response throws throwable; request http-request\n'
        adapter = adapter + '        response-format = select-response-format; request.accept, ' + (format-list-source; policy) + ', ' + (source-quote; policy.default-format) + '\n        if response-format == \'\'\n            return (create-response; 406, \'text/plain; charset=utf-8\', \'No acceptable response representation\').with-header; \'vary\', \'Accept\'\n'
    names list of string = list
    locations list of string = list
    path-names list of string = list
    body-index int = -1
    for parameter-index in (range; 0, (parameters.length;))
        parameter = at; parameters, parameter-index
        name = text; (get; parameter, 'name')
        record = parameter-record; declarations, identity, name, declaration
        if (truth; (get; parameter, 'mutable')) or (truth; (get; parameter, 'variadic'))
            fail; record, 'HTTP parameters cannot be mutable or variadic'
        kind = text; (get; parameter, 'type')
        path-meta = annotation; record, 'path', '/streaky/http-server/annotations'
        query-meta = annotation; record, 'query', '/streaky/http-server/annotations'
        body-meta = annotation; record, 'body', '/streaky/http-server/annotations'
        count int = 0
        if path-meta.kind != 'none'
            count = count + 1
        if query-meta.kind != 'none'
            count = count + 1
        if body-meta.kind != 'none'
            count = count + 1
        if count != 1
            fail; record, 'HTTP parameter requires exactly one path, query, or body annotation'
        variable = 'parameter-value' + parameter-index
        if parameter-index > 0
            arguments = arguments + ', '
        arguments = arguments + variable
        default = get; parameter, 'default'
        if body-meta.kind != 'none'
            if body-index != -1 or (not (is-document; kind) and not (is-model; kind, declarations)) or default.kind != 'none'
                fail; record, 'HTTP body requires one document-value or selected Terrane model parameter without a default'
            body-index = parameter-index
        else
            if (text; (get; parameter, 'type_kind')) != 'scalar' or (kind != 'string' and kind != 'int' and kind != 'bool')
                fail; record, 'HTTP path/query parameters must be canonical string, int, or bool scalars'
            location = 'query'
            transport-meta = query-meta
            if path-meta.kind != 'none'
                location = 'path'
                transport-meta = path-meta
            wire-name = metadata-string; transport-meta, 'name', record
            if wire-name == ''
                wire-name = name
            for previous in (range; 0, names.length)
                if names[previous] == wire-name and locations[previous] == location
                    fail; record, 'duplicate HTTP parameter transport name'
            names.append; wire-name
            locations.append; location
            optional = default.kind != 'none'
            if location == 'path'
                if optional or not (path.contains; ('{' + wire-name + '}'))
                    fail; record, 'path parameter must match a placeholder and cannot have a default'
                path-names.append; wire-name
            if (truth; (get; parameter, 'optional')) and not optional
                fail; record, 'optional HTTP parameter requires a compile-time default'
            parameter-entries = instance document-map-entries;
            parameter-entries.append; 'name', (make-document-string; wire-name)
            parameter-entries.append; 'in', (make-document-string; location)
            parameter-entries.append; 'required', (make-document-bool; not optional)
            parameter-documentation = declaration-documentation; record
            if parameter-documentation != ''
                parameter-entries.append; 'description', (make-document-string; parameter-documentation)
            examples = declaration-examples; record, 'application/json'
            if examples.kind != 'none'
                parameter-entries.append; 'examples', examples
            parameter-schema-entries = instance document-map-entries;
            parameter-schema-entries.append; 'type', (make-document-string; (schema-type; kind))
            initial = source-quote; ''
            if kind == 'int'
                initial = '0'
            else if kind == 'bool'
                initial = 'false'
            if optional
                initial = default-source; default, kind, record
                parameter-schema-entries.append; 'default', (default-json; default, kind, record)
            parameter-entries.append; 'schema', (object-value; parameter-schema-entries, record)
            parameter-values.append; (object-value; parameter-entries, record)
            adapter = adapter + '        ' + variable + ' ' + kind + ' = ' + initial + '\n        raw-value' + parameter-index + ' = request.' + location + '-value; ' + (source-quote; wire-name) + '\n        if raw-value' + parameter-index + ' != none\n'
            if kind == 'string'
                adapter = adapter + '            ' + variable + ' = raw-value' + parameter-index + '\n'
            else if kind == 'int'
                adapter = adapter + '            try\n                ' + variable + ' = raw-value' + parameter-index + '.radix; 10\n            catch\n                return validation-response; ' + (source-quote; ('Invalid integer ' + location + ' parameter: ' + wire-name)) + '\n'
            else
                adapter = adapter + '            if raw-value' + parameter-index + ' == \'true\'\n                ' + variable + ' = true\n            else if raw-value' + parameter-index + ' == \'false\'\n                ' + variable + ' = false\n            else\n                return validation-response; ' + (source-quote; ('Invalid boolean ' + location + ' parameter: ' + wire-name)) + '\n'
            if not optional
                adapter = adapter + '        else\n            return validation-response; ' + (source-quote; ('Missing required ' + location + ' parameter: ' + wire-name)) + '\n'
    segments = path.split; '/'
    placeholders list of string = list
    for segment in segments
        if (segment.contains.start; '{')
            name = segment.replace; (list; '{', '}'), ''
            matches int = 0
            for bound in path-names
                if bound == name
                    matches = matches + 1
            for previous in placeholders
                if previous == name
                    fail; declaration, 'duplicate HTTP path placeholder'
            placeholders.append; name
            if matches != 1
                fail; declaration, 'each HTTP path placeholder requires exactly one matching parameter'
    parameter-list = list-value; parameter-values, declaration
    entries.append; 'parameters', parameter-list
    if body-index != -1
        adapter = adapter + '        try\n            body-value = await request.json-body;\n        catch\n            return validation-response; \'Invalid JSON request body\'\n'
        body-parameter = at; parameters, body-index
        body-kind = text; (get; body-parameter, 'type')
        body-schema = object-value; (instance document-map-entries;), declaration
        if (is-model; body-kind, declarations)
            decoder = model-decoder; body-kind, declarations
            adapter = adapter + '        try\n            parameter-value' + body-index + ' = ' + decoder + '; body-value\n        catch\n            return validation-response; \'Invalid request model\'\n'
            body-schema = model-reference; body-kind, declarations
        else
            adapter = adapter + '        parameter-value' + body-index + ' = body-value\n'
        media-entries = instance document-map-entries;
        media-entries.append; 'schema', body-schema
        body-record = parameter-record; declarations, identity, (text; (get; body-parameter, 'name')), declaration
        examples = declaration-examples; body-record, 'application/json'
        if examples.kind != 'none'
            media-entries.append; 'examples', examples
        media-value = object-value; media-entries, declaration
        media-entries = instance document-map-entries;
        media-entries.append; 'application/json', media-value
        content-value = object-value; media-entries, declaration
        request-entries = instance document-map-entries;
        request-entries.append; 'required', (make-document-bool; true)
        body-documentation = declaration-documentation; body-record
        if body-documentation != ''
            request-entries.append; 'description', (make-document-string; body-documentation)
        request-entries.append; 'content', content-value
        entries.append; 'requestBody', (object-value; request-entries, declaration)
    response-entries = instance document-map-entries;
    result-description = operation-documentation; declaration, true
    if result-explicit
        if result-description == ''
            result-description = 'Explicit response status; HTTP error responses may also occur'
        examples = declaration-examples; declaration, content-type
        if examples.kind == 'none'
            response-entries.append; 'default', (response-description; result-description, declaration)
        else
            media-entries = instance document-map-entries;
            media-entries.append; 'examples', examples
            content-entries = instance document-map-entries;
            content-entries.append; content-type, (object-value; media-entries, declaration)
            response-entries.append; 'default', (response-with-content; result-description, (object-value; content-entries, declaration), declaration)
    else
        response-schema = object-value; (instance document-map-entries;), declaration
        if result-model
            response-schema = model-reference; result-kind, declarations
        else if not result-document
            response-schema = type-schema; (schema-type; result-kind)
        content-entries = instance document-map-entries;
        media-types list of string = list;
        if structured
            for format in policy.formats
                media-types.append; (format-media-type; format, declaration)
            entries.append; 'x-default-response-content-type', (make-document-string; (format-media-type; policy.default-format, declaration))
        else
            media-types.append; content-type
        for media-type in media-types
            media-entries = instance document-map-entries;
            media-schema = response-schema
            if media-type == 'application/xml'
                media-schema = xml-response-schema; response-schema, declaration
            media-entries.append; 'schema', media-schema
            examples = declaration-examples; declaration, media-type
            if examples.kind != 'none'
                media-entries.append; 'examples', examples
            content-entries.append; media-type, (object-value; media-entries, declaration)
        content-value = object-value; content-entries, declaration
        if result-description == ''
            result-description = 'Successful response'
        response-entries.append; '200', (response-with-content; result-description, content-value, declaration)
    response-entries.append; '422', (response-description; 'Request validation failed', declaration)
    if structured
        response-entries.append; '406', (response-description; 'No enabled response representation satisfies Accept', declaration)
    response-entries.append; '500', (response-description; 'Handler or response construction failed', declaration)
    if not result-explicit
        response-entries.append; 'default', (response-description; 'HTTP error response', declaration)
    entries.append; 'responses', (object-value; response-entries, declaration)
    schema = object-value; entries, declaration
    adapter = adapter + '        result = await ' + target + ';'
    if arguments != ''
        adapter = adapter + ' ' + arguments
    adapter = adapter + '\n'
    if result-explicit
        adapter = adapter + '        return result\n'
    else if not structured
        adapter = adapter + '        return create-response; 200, ' + (source-quote; content-type) + ', result\n'
    else
        if result-document
            adapter = adapter + '        document = result\n'
        else if result-model
            adapter = adapter + '        document = ' + (model-encoder; result-kind, declarations) + '; result\n'
        else if result-kind == 'int'
            adapter = adapter + '        document-result = make-document-integer; (\'\' + result)\n        if document-result.failed\n            throw coercion-error\n        document = document-result.value\n'
        else
            factory = 'make-document-' + result-kind
            adapter = adapter + '        document = ' + factory + '; result\n'
        adapter = adapter + '        return create-document-response; 200, document, response-format\n'
    mounted-path = path
    if prefix != '/'
        mounted-path = prefix + path
    return instance operation; path, method, operation-id, schema, adapter, owner, mounted-path, documented


function static-directory-source string throws consumer-error; declaration document-value, prefix string
    code string = ''
    applications = get; declaration, 'annotations'
    for index in (range; 0, (applications.length;))
        application = at; applications, index
        if (text; (get; application, 'identity')) == '/streaky/http-server/annotations::static-directory'
            payload = get; application, 'payload'
            pairs = get; payload, 'value'
            path string = ''
            directory string = ''
            for pair-index in (range; 0, (pairs.length;))
                pair = at; pairs, pair-index
                key = text; (get; (at; pair, 0), 'value')
                value = text; (scalar; (at; pair, 1))
                if key == 'path'
                    path = value
                else if key == 'directory'
                    directory = value
            route-shape; path, declaration
            if directory == '' or (directory.contains.start; '/') or (directory.contains; '..')
                fail; declaration, 'static-directory must name a nonempty relative directory without parent traversal'
            mounted = path
            if prefix != '/'
                mounted = prefix + path
            code = code + '    app = app.static-directory; ' + (source-quote; mounted) + ', ' + (source-quote; directory) + '\n'
    return code

function generate string throws consumer-error; request document-value
    engine = make-code-engine;
    declarations = get; request, 'declarations'
    endpoints list of document-value = list
    groups list of document-value = list
    for index in (range; 0, (declarations.length;))
        declaration = at; declarations, index
        kind = text; (get; declaration, 'kind')
        if kind == 'callable'
            metadata = annotation; declaration, 'endpoint', '/streaky/http-server/annotations'
            if metadata.kind != 'none'
                endpoints.append; declaration
        else if kind == 'class'
            metadata = annotation; declaration, 'route-group', '/streaky/http-server/annotations'
            if metadata.kind != 'none'
                groups.append; declaration
    if endpoints.length == 0
        fail; request, 'HTTP consumer requires at least one annotated endpoint'
    imports string = ''
    for index in (range; 0, groups.length)
        group = groups[index]
        identity = text; (get; group, 'identity')
        pieces = identity.split; '::'
        imports = imports + 'from ' + pieces[0] + ' import ' + pieces[1] + ' as route-source' + index + '\n'
        metadata = annotation; group, 'route-group', '/streaky/http-server/annotations'
        prefix = metadata-string; metadata, 'prefix', group
        route-shape; prefix, group
        for previous-index in (range; 0, index)
            previous = groups[previous-index]
            previous-meta = annotation; previous, 'route-group', '/streaky/http-server/annotations'
            if (metadata-string; previous-meta, 'prefix', previous) == prefix
                fail; group, 'duplicate HTTP route-group mount prefix'
    operations list of operation = list
    standalone bool = false
    for index in (range; 0, endpoints.length)
        declaration = endpoints[index]
        current = make-operation; declaration, declarations, index
        for previous in operations
            if current.identity == previous.identity
                fail; declaration, 'duplicate HTTP operation ID'
            if current.mounted-path == previous.mounted-path and current.method == previous.method
                fail; declaration, 'duplicate HTTP method/path route'
            if current.mounted-path != previous.mounted-path and (route-shape; current.mounted-path, declaration) == (route-shape; previous.mounted-path, declaration)
                fail; declaration, 'conflicting HTTP path placeholder names'
        operations.append; current
        if current.owner == ''
            standalone = true
            identity = text; (get; declaration, 'identity')
            pieces = identity.split; '::'
            imports = imports + 'from ' + pieces[0] + ' import ' + pieces[1] + ' as selected-handler' + index + '\n'
    generated-values map of string, template-value = map;
    generated-values.set; 'imports', (text-value; imports)
    generated-values.set; 'model-codecs', (text-value; (model-codecs; ref engine, declarations))
    generated = render-code; ref engine, 'http/preamble.trn.tpl', generated-values
    paths-entries = instance document-map-entries;
    path-names list of string = list
    for current in operations
        seen bool = false
        for previous in path-names
            if previous == current.mounted-path
                seen = true
        if current.documented and not seen
            path-names.append; current.mounted-path
            method-entries = instance document-map-entries;
            for item in operations
                if item.documented and item.mounted-path == current.mounted-path
                    method-entries.append; (method-key; item.method, request), (item.schema.to-document;)
            paths-entries.append; current.mounted-path, (object-value; method-entries, request)
    path-value = object-value; paths-entries, request
    info-value = api-info; declarations
    server-entries = instance document-map-entries;
    server-entries.append; 'url', (make-document-string; '/')
    server-value = object-value; server-entries, request
    server-values list of document-value = list
    server-values.append; server-value
    servers-value = list-value; server-values, request
    component-entries = instance document-map-entries;
    component-entries.append; 'schemas', (model-schemas; declarations)
    components-value = object-value; component-entries, request
    openapi-entries = instance document-map-entries;
    openapi-entries.append; 'openapi', (make-document-string; '3.1.0')
    openapi-entries.append; 'info', info-value
    openapi-entries.append; 'servers', servers-value
    openapi-entries.append; 'paths', path-value
    openapi-entries.append; 'components', components-value
    openapi-value = object-value; openapi-entries, request
    encoded-openapi = encode-document; openapi-value, request
    openapi-values map of string, template-value = map;
    openapi-values.set; 'source', (text-value; (source-quote; encoded-openapi))
    generated = generated + (render-code; ref engine, 'http/openapi-json.trn.tpl', openapi-values)
    validation-values map of string, template-value = map;
    generated = generated + (render-code; ref engine, 'http/validation-response.trn.tpl', validation-values)
    if standalone
        generated = generated + (controller-source; ref engine, 'annotated-controller', '', '', operations, true)
    for index in (range; 0, groups.length)
        group = groups[index]
        owner = text; (get; group, 'identity')
        metadata = annotation; group, 'route-group', '/streaky/http-server/annotations'
        documented = truth; (scalar; (get; metadata, 'document'))
        generated = generated + (controller-source; ref engine, 'annotated-group' + index, owner, 'route-source' + index, operations, documented)
    generated = generated + '\npublic function mount-annotated application; app application\n'
    if standalone
        generated = generated + '    app = app.mount; \'/\', (instance annotated-controller;)\n'
    for index in (range; 0, groups.length)
        group = groups[index]
        metadata = annotation; group, 'route-group', '/streaky/http-server/annotations'
        prefix = metadata-string; metadata, 'prefix', group
        generated = generated + '    app = app.mount; ' + (source-quote; prefix) + ', (instance annotated-group' + index + '; (instance route-source' + index + ';))\n'
        generated = generated + (static-directory-source; group, prefix)
    generated = generated + '    return app\n'
    return generated

function main;
    try
        request = read-request;
        emit-source; 'http-server', (generate; request)
    catch consumer-error as error
        emit-error; (error-origin;), error.message

main
