namespace http-server-consumer/models

from /http-server-consumer/rendering import render-code
from /streaky/template import template-engine, template-value, text-value, bool-value

from /terrane/annotation-consumer-protocol import get, at, text, truth, annotation, consumer-error
from /core/collections import list, range, map
from /core/documents import document-value, document-map-entries, make-document-none, make-document-string, make-document-bool, make-document-map
from /http-server-consumer/documents import object-value, list-value, type-schema, source-quote, documented-schema
from /core/errors import replace-error
from /http-server-consumer/formats import named-xml-schema

function model-error; declaration document-value, message string
    throw (instance consumer-error; declaration, message)

function type-name string; field document-value
    raw = text; (get; field, 'type')
    if (raw.contains.start; 'list of ')
        item = raw.replace; 'list of ', ''
        return 'list of ' + (item.replace; ' ', '')
    return raw.replace; ' ', ''

function short-name string; identity string
    pieces = identity.split; '::'
    return pieces[pieces.length - 1]

function model-alias string; identity string
    try
        # Escape '_' first: ordered replacements must not re-escape later escape prefixes.
        return 'http-model-' + (identity.replace; (list; '_', '/', ':'), (list; '_5f', '_2f', '_3a'))
    catch replace-error
        throw (instance consumer-error; (make-document-none;), 'HTTP model identity escape table has unequal search/replacement counts')

function class-record document-value throws consumer-error; kind string, declarations document-value
    index int = 0
    count int = 0
    found = make-document-none;
    while index < (declarations.length;)
        record = at; declarations, index
        identity = text; (get; record, 'identity')
        if (text; (get; record, 'kind')) == 'class' and not (route-group-class; record) and (identity == kind or (short-name; identity) == kind)
            found = record
            count = count + 1
        index = index + 1
    if count > 1
        model-error; found, ('ambiguous short model name: ' + kind)
    if count == 1
        return found
    model-error; (make-document-none;), ('no selected model class for ' + kind)
    return make-document-none;

function is-model bool; kind string, declarations document-value
    index int = 0
    while index < (declarations.length;)
        record = at; declarations, index
        identity = text; (get; record, 'identity')
        if (text; (get; record, 'kind')) == 'class' and not (route-group-class; record) and (identity == kind or (short-name; identity) == kind)
            return true
        index = index + 1
    return false

function route-group-class bool; declaration document-value
    metadata = annotation; declaration, 'route-group', '/streaky/http-server/annotations'
    return metadata.kind != 'none'

# Class field summaries carry type/default contracts, not declaration documentation.
# Resolve their canonical origin, as the codec consumer does, without requiring
# callers to select field metadata when they do not need field descriptions.
function field-declaration document-value; field document-value, declarations document-value
    origin = get; field, 'origin'
    for index in (range; 0, (declarations.length;))
        record = at; declarations, index
        span = get; record, 'span'
        if (text; (get; record, 'kind')) == 'field' and (text; (get; span, 'file')) == (text; (get; origin, 'file')) and (text; (get; span, 'start')) == (text; (get; origin, 'start')) and (text; (get; span, 'end')) == (text; (get; origin, 'end'))
            return record
    return make-document-none;

function model-schema document-value throws consumer-error; kind string, declarations document-value
    cls = class-record; kind, declarations
    fields = get; cls, 'fields'
    entries = instance document-map-entries;
    entries.append; 'title', (make-document-string; (short-name; (text; (get; cls, 'identity'))))
    entries.append; 'type', (make-document-string; 'object')
    properties = instance document-map-entries;
    required-values list of document-value = list
    index int = 0
    while index < (fields.length;)
        field = at; fields, index
        if (text; (get; field, 'visibility')) == 'public' and not (truth; (get; field, 'static'))
            name = text; (get; field, 'external_name')
            properties.append; name, (schema-field; field, declarations)
            if not (truth; (get; field, 'optional')) and not (truth; (get; field, 'defaulted'))
                required-values.append; (make-document-string; name)
        index = index + 1
    entries.append; 'properties', (object-value; properties, (make-document-none;))
    entries.append; 'additionalProperties', (make-document-bool; false)
    if required-values.length > 0
        entries.append; 'required', (list-value; required-values, (make-document-none;))
    return documented-schema; (object-value; entries, cls), cls

function schema-field document-value throws consumer-error; field document-value, declarations document-value
    kind = type-name; field
    optional = (kind.contains.end; '|none')
    base = kind
    if optional
        base = kind.replace; '|none', ''
    schema = model-field-schema; base, declarations, field
    if optional
        alternatives list of document-value = list
        alternatives.append; schema
        alternatives.append; (type-schema; 'null')
        wrapper = instance document-map-entries;
        wrapper.append; 'anyOf', (list-value; alternatives, field)
        schema = object-value; wrapper, field
    return documented-schema; schema, (field-declaration; field, declarations)

function integer-kind bool; kind string
    return kind == 'int' or kind == 'int8' or kind == 'int16' or kind == 'int32' or kind == 'int64' or kind == 'int128' or kind == 'uint8' or kind == 'uint16' or kind == 'uint32' or kind == 'uint64' or kind == 'uint128'

function model-field-schema document-value throws consumer-error; kind string, declarations document-value, field document-value
    if kind == 'string'
        return type-schema; 'string'
    if integer-kind; kind
        return type-schema; 'integer'
    if kind == 'float' or kind == 'float32' or kind == 'float64'
        return type-schema; 'number'
    if kind == 'bool'
        return type-schema; 'boolean'
    if (kind.contains; 'list of ')
        item-kind = kind.replace; 'list of ', ''
        items = instance document-map-entries;
        items.append; 'type', (make-document-string; 'array')
        item-schema = model-field-schema; item-kind, declarations, field
        items.append; 'items', (named-xml-schema; item-schema, 'item', field)
        xml = instance document-map-entries;
        xml.append; 'wrapped', (make-document-bool; true)
        items.append; 'xml', (object-value; xml, field)
        return (object-value; items, field)
    if is-model; kind, declarations
        return (model-reference; kind, declarations)
    model-error; field, ('unsupported model field type: ' + kind)
    return (make-document-none;)

function model-reference document-value throws consumer-error; kind string, declarations document-value
    cls = class-record; kind, declarations
    identity = text; (get; cls, 'identity')
    entries = instance document-map-entries;
    entries.append; '$ref', (make-document-string; ('#/components/schemas/' + (model-alias; identity)))
    return (object-value; entries, cls)

function model-schemas document-value throws consumer-error; declarations document-value
    schemas = instance document-map-entries;
    for index in (range; 0, (declarations.length;))
        cls = at; declarations, index
        if (text; (get; cls, 'kind')) == 'class' and not (route-group-class; cls)
            identity = text; (get; cls, 'identity')
            schemas.append; (model-alias; identity), (model-schema; identity, declarations)
    return (object-value; schemas, declarations)

function model-codecs string throws consumer-error; engine ref template-engine, declarations document-value
    generated = 'from /core/collections import list\nfrom /core/documents import document-value, document-map-entries, make-document-none, make-document-string, make-document-bool, make-document-integer, make-document-decimal, make-document-list, make-document-map\nfrom /core/errors import coercion-error, throwable\n'
    for index in (range; 0, (declarations.length;))
        cls = at; declarations, index
        if (text; (get; cls, 'kind')) == 'class' and not (route-group-class; cls)
            identity = text; (get; cls, 'identity')
            pieces = identity.split; '::'
            class-name = short-name; identity
            class-alias = model-alias; identity
            generated = generated + 'from ' + pieces[0] + ' import ' + class-name + ' as ' + class-alias + '\n'
    generated = generated + '\n'
    generated = generated + (floating-codecs; declarations)
    for index in (range; 0, (declarations.length;))
        cls = at; declarations, index
        if (text; (get; cls, 'kind')) == 'class' and not (route-group-class; cls)
            identity = text; (get; cls, 'identity')
            generated = generated + (codec-for; ref engine, identity, declarations)
    return generated

# Decimal document text needs the standard finite binary-float parser, not numeric coercion.
function floating-codecs string throws consumer-error; declarations document-value
    generated string = ''
    for precision in (list; '32', '64')
        needed bool = false
        for index in (range; 0, (declarations.length;))
            cls = at; declarations, index
            if (text; (get; cls, 'kind')) == 'class' and not (route-group-class; cls)
                fields = get; cls, 'fields'
                for field-index in (range; 0, (fields.length;))
                    kind = type-name; (at; fields, field-index)
                    kind = kind.replace; (list; '|none', 'list of '), ''
                    if kind == ('float' + precision) or (precision == '64' and kind == 'float')
                        needed = true
        if needed
            if generated == ''
                generated = 'from /core/documents/json import parse-json, default-json-options\n\n'
            generated = generated + 'class parsed-model-float' + precision + '\n    value float' + precision + ' = 0.0\n    failed bool = true\n\nfunction parse-model-float' + precision + ' float' + precision + ' throws coercion-error; text string\n    parsed parsed-model-float' + precision + ' = rust\n        match text.parse::<f' + precision + '>() {\n            Ok(value) if value.is_finite() => ParsedModelFloat' + precision + ' { value, failed: false },\n            _ => ParsedModelFloat' + precision + ' { value: 0.0, failed: true },\n        }\n    if parsed.failed\n        throw coercion-error\n    return parsed.value\n\n'
            generated = generated + 'function encode-model-float' + precision + ' document-value; value float' + precision + '\n    return (parse-json; (\'\' + value), (default-json-options;)).value\n\n'
    return generated

function model-encoder string throws consumer-error; kind string, declarations document-value
    cls = class-record; kind, declarations
    return (model-alias; (text; (get; cls, 'identity'))) + '-to-document'

function model-decoder string throws consumer-error; kind string, declarations document-value
    cls = class-record; kind, declarations
    return (model-alias; (text; (get; cls, 'identity'))) + '-from-document'

function codec-for string throws consumer-error; engine ref template-engine, kind string, declarations document-value
    cls = class-record; kind, declarations
    contracts = get; cls, 'contracts'
    constructor = get; contracts, 'constructor'
    base-class = get; contracts, 'base'
    if (text; (get; cls, 'visibility')) != 'public' or constructor.kind != 'none' or base-class.kind != 'none'
        model-error; cls, 'model codec requires a public non-derived class with its canonical default constructor'
    fields = get; cls, 'fields'
    identity = text; (get; cls, 'identity')
    name = model-alias; identity
    values map of string, template-value = map;
    values.set; 'name', (text-value; name)
    values.set; 'fields', (text-value; (encode-field-fragments; ref engine, fields, declarations))
    source = render-code; ref engine, 'models/encode-model.trn.tpl', values
    values.set; 'unknown-field-condition', (text-value; (unknown-field-condition; fields))
    source = source + (render-code; ref engine, 'models/decode-model.trn.tpl', values)
    for ix in (range; 0, (fields.length;))
        field = at; fields, ix
        if (text; (get; field, 'visibility')) == 'public' and not (truth; (get; field, 'static'))
            source = source + (decode-field; ref engine, field, ix, declarations)
    return source + '    return value\n\n'

function encode-field-fragments string throws consumer-error; engine ref template-engine, fields document-value, declarations document-value
    source = ''
    for ix in (range; 0, (fields.length;))
        field = at; fields, ix
        if (text; (get; field, 'visibility')) == 'public' and not (truth; (get; field, 'static'))
            source = source + (encode-field; ref engine, field, ix, declarations)
    return source

function unknown-field-condition string throws consumer-error; fields document-value
    condition = 'true'
    for ix in (range; 0, (fields.length;))
        field = at; fields, ix
        if (text; (get; field, 'visibility')) == 'public' and not (truth; (get; field, 'static'))
            if condition == 'true'
                condition = ''
            else
                condition = condition + ' and '
            condition = condition + 'key != ' + (source-quote; (text; (get; field, 'external_name')))
    return condition
function decode-field string throws consumer-error; engine ref template-engine, field document-value, index int, declarations document-value
    member = text; (get; field, 'name')
    wire = text; (get; field, 'external_name')
    kind = type-name; field
    optional = (kind.contains.end; '|none')
    base = kind
    if optional
        base = kind.replace; '|none', ''
    indent = '        '
    if optional
        indent = '            '
    values map of string, template-value = map;
    values.set; 'index', (text-value; (index.to-string;))
    values.set; 'wire', (text-value; (source-quote; wire))
    values.set; 'member', (text-value; member)
    values.set; 'required', (bool-value; not optional and not (truth; (get; field, 'defaulted')))
    values.set; 'optional', (bool-value; optional)
    values.set; 'assignment', (text-value; (decode-assignment; ref engine, base, member, index, declarations, field, indent))
    return render-code; ref engine, 'models/decode-field.trn.tpl', values

function decode-assignment string throws consumer-error; engine ref template-engine, kind string, member string, index int, declarations document-value, field document-value, indent string
    if (kind.contains.start; 'list of ')
        item = kind.replace; 'list of ', ''
        item-class = item
        if is-model; item, declarations
            item-class = model-alias; (text; (get; (class-record; item, declarations), 'identity'))
        item-check = ''
        expected = document-kind; item
        if expected == 'float'
            item-check = indent + '    if item' + index + '.value.kind != \'decimal\' and item' + index + '.value.kind != \'integer\'\n' + indent + '        throw coercion-error\n'
        else if expected != 'map'
            item-check = indent + '    if item' + index + '.value.kind != ' + (source-quote; expected) + '\n' + indent + '        throw coercion-error\n'
        values map of string, template-value = map;
        values.set; 'indent', (text-value; indent)
        values.set; 'index', (text-value; (index.to-string;))
        values.set; 'item-class', (text-value; item-class)
        values.set; 'item-check', (text-value; item-check)
        values.set; 'item-expression', (text-value; (decode-expression; item, ('item' + index + '.value'), declarations, field))
        values.set; 'member', (text-value; member)
        return render-code; ref engine, 'models/decode-list-assignment.trn.tpl', values
    expected = document-kind; kind
    check = ''
    if expected == 'float'
        check = indent + 'if slot' + index + '.value.kind != \'decimal\' and slot' + index + '.value.kind != \'integer\'\n' + indent + '    throw coercion-error\n'
    else if expected != 'map'
        check = indent + 'if slot' + index + '.value.kind != ' + (source-quote; expected) + '\n' + indent + '    throw coercion-error\n'
    return check + indent + 'value.' + member + ' = ' + (decode-expression; kind, ('slot' + index + '.value'), declarations, field) + '\n'

function document-kind string; kind string
    if integer-kind; kind
        return 'integer'
    if kind == 'bool'
        return 'bool'
    if kind == 'float' or kind == 'float32' or kind == 'float64'
        return 'float'
    if (kind.contains.start; 'list of ')
        return 'list'
    if kind == 'string'
        return 'string'
    return 'map'

function encode-field string throws consumer-error; engine ref template-engine, field document-value, index int, declarations document-value
    member = text; (get; field, 'name')
    wire = text; (get; field, 'external_name')
    kind = type-name; field
    optional = (kind.contains.end; '|none')
    base = kind
    if optional
        base = kind.replace; '|none', ''
        local = 'member-value' + index
        prefix = '    ' + local + ' = value.' + member + '\n    if ' + local + ' != none\n'
        suffix = '    else\n        entries.append; ' + (source-quote; wire) + ', (make-document-none;)\n'
        if (base.contains.start; 'list of ')
            return prefix + (encode-list-field; ref engine, base, local, wire, index, declarations, field, '        ') + suffix
        return prefix + '        entries.append; ' + (source-quote; wire) + ', ' + (encode-expression; base, local, declarations, field) + '\n' + suffix
    if (base.contains.start; 'list of ')
        return (encode-list-field; ref engine, base, ('value.' + member), wire, index, declarations, field, '    ')
    return '    entries.append; ' + (source-quote; wire) + ', ' + (encode-expression; base, ('value.' + member), declarations, field) + '\n'

function encode-list-field string throws consumer-error; engine ref template-engine, kind string, expression string, wire string, index int, declarations document-value, field document-value, indent string
    item = kind.replace; 'list of ', ''
    item-expression = expression + '[item-index' + index + ']'
    values map of string, template-value = map;
    values.set; 'indent', (text-value; indent)
    values.set; 'index', (text-value; (index.to-string;))
    values.set; 'expression', (text-value; expression)
    values.set; 'item-expression', (text-value; (encode-expression; item, item-expression, declarations, field))
    values.set; 'wire', (text-value; (source-quote; wire))
    return render-code; ref engine, 'models/encode-list-field.trn.tpl', values

function encode-expression string throws consumer-error; kind string, expression string, declarations document-value, field document-value
    if kind == 'string'
        return '(make-document-string; ' + expression + ')'
    if kind == 'bool'
        return '(make-document-bool; ' + expression + ')'
    if integer-kind; kind
        return '(make-document-integer; (' + expression + '.to-string;)).value'
    if kind == 'float' or kind == 'float32' or kind == 'float64'
        if kind == 'float'
            kind = 'float64'
        return '(encode-model-' + kind + '; ' + expression + ')'
    if (kind.contains; 'list of ')
        model-error; field, 'list model fields require generated element codecs'
    if is-model; kind, declarations
        return '(' + (model-alias; (text; (get; (class-record; kind, declarations), 'identity'))) + '-to-document; ' + expression + ')'
    model-error; field, ('unsupported model field type: ' + kind)
    return ''

function decode-expression string throws consumer-error; kind string, expression string, declarations document-value, field document-value
    if kind == 'string'
        return expression + '.scalar'
    if kind == 'bool'
        return '(' + expression + '.scalar == \'true\')'
    if integer-kind; kind
        return '(' + expression + '.scalar.radix; 10)'
    if kind == 'float' or kind == 'float32' or kind == 'float64'
        if kind == 'float'
            kind = 'float64'
        return '(parse-model-' + kind + '; ' + expression + '.scalar)'
    if (kind.contains; 'list of ')
        model-error; field, 'list model fields require generated element codecs'
    if is-model; kind, declarations
        return '(' + (model-alias; (text; (get; (class-record; kind, declarations), 'identity'))) + '-from-document; ' + expression + ')'
    model-error; field, ('unsupported model field type: ' + kind)
    return ''

