namespace streaky/http-server

from /deps/axum/extract import OriginalUri as original-uri
from /deps/axum-core/extract import Request as native-request
from /deps/ipnet import IpAddr as ip-addr
from /deps/axum-core/body import Body as native-body
from /deps/http/request import Builder as request-builder
from /deps/http import HeaderValue as native-header-value, HeaderName as native-header-name, Uri as native-uri
from /core/collections import list
from /core/testing import assert-equal-bool, assert-equal-string, assert-equal-int

function test-request-path-prefers-original-uri-and-excludes-query;
    builder = request-builder::new;
    builder = builder.uri; '/item%20one?active=true'
    request = builder.body; (native-body::empty;)
    direct = capture-request-context; request, '/item'
    assert-equal-string; (direct.path;), '/item%20one'
    assert-equal-string; (direct.target;), '/item%20one?active=true'

    uri = native-uri::from_str; '/mounted/item%20one?active=true'
    original = instance original-uri; move uri
    (request.extensions_mut;).insert; move original
    mounted = capture-request-context; request, '/item'
    assert-equal-string; (mounted.path;), '/mounted/item%20one'
    assert-equal-string; (mounted.target;), '/mounted/item%20one?active=true'

    authority-only = native-uri::from_str; 'example.test:443'
    original = instance original-uri; move authority-only
    (request.extensions_mut;).insert; move original
    mounted = capture-request-context; request, '/item'
    assert-equal-string; (mounted.target;), '/'

function test-request-authority-prefers-uri-and-rejects-non-ascii-host;
    builder = request-builder::new;
    builder = builder.uri; '/item'
    builder = builder.header; 'host', 'example.test'
    request = builder.body; (native-body::empty;)
    direct = capture-request-context; request, '/item'
    authority = direct.authority;
    assert-equal-bool; authority != none, true
    if authority != none
        assert-equal-string; authority, 'example.test'

    name = native-header-name::from_str; 'host'
    invalid = native-header-value::from_bytes; (list; 195, 169)
    (request.headers_mut;).insert; name, invalid
    direct = capture-request-context; request, '/item'
    assert-equal-bool; (direct.authority;) == none, true

    builder = request-builder::new;
    builder = builder.uri; 'http://uri.test/item'
    builder = builder.header; 'host', 'ignored.test'
    request = builder.body; (native-body::empty;)
    direct = capture-request-context; request, '/item'
    authority = direct.authority;
    assert-equal-bool; authority != none, true
    if authority != none
        assert-equal-string; authority, 'uri.test'

function context-with-forwarding request-context; forwarded string, legacy string, trusted bool
    builder = request-builder::new;
    builder = builder.uri; '/metadata'
    if forwarded != ''
        builder = builder.header; 'forwarded', forwarded
    if legacy != ''
        builder = builder.header; 'x-forwarded-proto', legacy
    request-body = native-body::empty;
    built = builder.body; move request-body
    native = trust-test-request; move built, trusted
    return capture-request-context; native, '/metadata'

private function trust-test-request native-request; request native-request, trusted bool
    install-proxy-metadata; request, none, trusted
    return move request

function test-forwarded-scheme-respects-trust-and-standard-precedence;
    untrusted = context-with-forwarding; 'for=192.0.2.1;proto=https', 'https', false
    scheme = untrusted.scheme;
    assert-equal-bool; scheme != none, true
    if scheme != none
        assert-equal-string; scheme, 'http'
    for header in (list; 'for=192.0.2.1;proto=https', 'for="[2001:db8::1]";proto="HTTPS"', 'for=192.0.2.1;by="edge,a;b";proto=https')
        trusted = context-with-forwarding; header, 'http', true
        scheme = trusted.scheme;
        assert-equal-bool; scheme != none, true
        if scheme != none
            assert-equal-string; scheme, 'https'
    legacy = context-with-forwarding; '', 'http, https', true
    scheme = legacy.scheme;
    assert-equal-bool; scheme != none, true
    if scheme != none
        assert-equal-string; scheme, 'https'

function test-undecodable-rightmost-legacy-scheme-fails-closed;
    builder = request-builder::new;
    builder = builder.uri; '/metadata'
    builder = builder.header; 'x-forwarded-proto', 'https'
    invalid = native-header-value::from_bytes; (list; 255)
    builder = builder.header; 'x-forwarded-proto', invalid
    built = builder.body; (native-body::empty;)
    native = trust-test-request; move built, true
    context = capture-request-context; native, '/metadata'
    assert-equal-bool; (context.scheme;) == none, true

function test-trusted-forwarding-without-scheme-is-unknown;
    context = context-with-forwarding; '', '', true
    assert-equal-bool; (context.scheme;) == none, true

function test-ambiguous-forwarded-scheme-never-promotes-to-https;
    for header in (list; 'for=192.0.2.1;by="edge;proto=https;other=value"', 'for=192.0.2.1;proto="https', 'for=192.0.2.1;proto=http;proto=https', 'for=192.0.2.1;proto=invalid', 'for=192.0.2.1')
        context = context-with-forwarding; header, 'https', true
        assert-equal-bool; (context.scheme;) == none, true

function test-unrelated-bool-and-ip-extensions-do-not-collide;
    built = native-request::new; (native-body::empty;)
    (built.extensions_mut;).insert; true
    spoof ip-addr = ip-addr::from_str; '192.0.2.99'
    (built.extensions_mut;).insert; spoof
    native = trust-test-request; move built, false
    context = capture-request-context; native, '/'
    assert-equal-bool; (context.via-trusted-proxy;) == false, true
    assert-equal-bool; (context.client-ip;) == none, true

function test-request-snapshot-retains-invalid-bytes-without-fabricating-text;
    builder = request-builder::new;
    builder = builder.uri; '/metadata?x=1'
    builder = builder.header; 'x-tag', 'first'
    invalid-header = native-header-value::from_bytes; (list; 255)
    builder = builder.header; 'x-tag', invalid-header
    builder = builder.header; 'x-tag', 'last'
    native = builder.body; (native-body::empty;)
    context = capture-request-context; native, '/metadata'
    assert-equal-int; (context.header-byte-count;), 25
    values = context.header-values; 'X-Tag'
    assert-equal-int; values.length, 2
    assert-equal-string; values[0], 'first'
    assert-equal-string; values[1], 'last'
    raw = context.header-bytes; 'x-tag'
    assert-equal-int; raw.length, 3
    invalid = raw[1]
    assert-equal-int; invalid[0], 255
    assert-equal-string; (context.target;), '/metadata?x=1'
    assert-equal-bool; (context.authority;) == none, true
    assert-equal-bool; (context.url;) == none, true

function test-header-snapshot-owns-values-and-detaches-accessor-results;
    builder = request-builder::new;
    invalid-header = native-header-value::from_bytes; (list; 255)
    accent = native-header-value::from_bytes; (list; 99, 97, 102, 195, 169)
    builder = builder.header; 'x-tag', invalid-header
    builder = builder.header; 'x-tag', accent
    builder = builder.header; 'x-tag', 'last'
    native = builder.body; (native-body::empty;)
    original = capture-request-context; native, '/'
    key = native-header-name::from_str; 'x-tag'
    value = native-header-value::from_str; 'changed'
    (native.headers_mut;).insert; key, value
    successor = capture-request-context; native, '/'
    assert-equal-int; (original.header-byte-count;), 25
    assert-equal-int; (successor.header-byte-count;), 12
    first = original.header-value; 'X-TAG'
    assert-equal-bool; first != none, true
    if first != none
        assert-equal-string; first, 'café'
    assert-equal-bool; (original.header-value; 'missing') == none, true
    assert-equal-bool; (original.header-value; 'not a header') == none, true
    values = original.header-values; 'x-tag'
    assert-equal-int; values.length, 2
    assert-equal-string; values[0], 'café'
    assert-equal-string; values[1], 'last'
    changed = successor.header-value; 'x-tag'
    assert-equal-bool; changed != none, true
    if changed != none
        assert-equal-string; changed, 'changed'
    raw = original.header-bytes; 'X-Tag'
    assert-equal-int; raw.length, 3
    raw[1] = raw[0]
    again = original.header-bytes; 'x-tag'
    invalid = again[0]
    valid = again[1]
    assert-equal-int; invalid[0], 255
    assert-equal-int; valid[0], 99
