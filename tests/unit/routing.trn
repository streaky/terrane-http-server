namespace tests/http-server/routing

from /streaky/http-server import application, controller, websocket-session, create-application, parse-config-yaml
from /streaky/http-server/internal import routes, http-method, incoming-request, wire-response, encoded-response
from /core/errors import dependency-error
from /core/testing import assert-equal-bool, assert-equal-string

class site implements controller
    consuming function routes routes; registered-routes routes
        registered-routes = registered-routes.endpoint; (instance http-method::get;), '/', this.home
        registered-routes = registered-routes.endpoint; (instance http-method::get;), '/about', this.about
        return registered-routes

    async function home wire-response; _request incoming-request
        return encoded-response; 200, 'text/plain', 'hello from Terrane'

    async function about wire-response; _request incoming-request
        return encoded-response; 200, 'text/plain', 'about'

class api implements controller
    consuming function routes routes; registered-routes routes
        registered-routes = registered-routes.endpoint; (instance http-method::get;), '/health', this.health
        return registered-routes

    async function health wire-response; _request incoming-request
        return encoded-response; 200, 'text/plain', 'ok'

async function ignore-session none throws dependency-error; _session websocket-session
    return none

function test-empty-application-has-no-routes;
    app application = create-application;
    assert-equal-bool; (app.has-routes;), false

function test-controller-mount-registers-relative-routes;
    app application = create-application;
    app = app.mount; '/', (instance site;)
    assert-equal-bool; (app.has-routes;), true

function test-nested-controller-and-static-directory-mounts;
    app application = create-application;
    app = app.mount; '/api', (instance api;)
    app = app.static-directory; '/static', '.'
    assert-equal-bool; (app.has-routes;), true

function test-exact-root-and-prefixed-mounts-coexist;
    app application = create-application;
    app = app.mount; '/', (instance site;)
    app = app.mount; '/api', (instance api;)
    app = app.static-directory; '/assets', '.'
    assert-equal-bool; (app.has-routes;), true

function test-address-is-framework-state;
    app application = create-application;
    app = app.with-address; '127.0.0.1:8080'
    assert-equal-string; app.address, '127.0.0.1:8080'

function test-access-policies-and-websocket-routes-compose;
    app application = create-application;
    app = app.allow-direct; '127.0.0.0/8'
    app = app.allow-direct; '::1/128'
    app = app.allow-client; '192.0.2.0/24'
    app = app.allow-client; '2001:db8::/32'
    app = app.websocket; '/socket/events', ignore-session
    assert-equal-bool; (app.has-routes;), true

function test-yaml-configures-address-static-content-and-controller-prefixes;
    source = 'address: 127.0.0.1:8080\nmounts:\n  - controller: site\n    path: /\n  - static-directory: public\n    path: /assets'
    parsed = parse-config-yaml; source
    assert-equal-bool; parsed.failed, false
    assert-equal-string; parsed.config.address, '127.0.0.1:8080'
    site-path = parsed.config.controller-path; 'site'
    if site-path != none
        assert-equal-string; site-path, '/'
    else
        assert-equal-bool; true, false
    app application = create-application;
    app = app.configure; parsed.config
    assert-equal-string; app.address, '127.0.0.1:8080'
    assert-equal-bool; (app.has-routes;), true

function test-yaml-rejects-ambiguous-mounts;
    parsed = parse-config-yaml; 'mounts:\n  - controller: site\n    static-directory: public\n    path: /'
    assert-equal-bool; parsed.failed, true
    assert-equal-string; parsed.message, 'each mount requires exactly one of controller or static-directory'

function test-yaml-rejects-malformed-and-colliding-mounts;
    malformed = parse-config-yaml; 'mounts:\n  - controller: site\n    path: relative'
    assert-equal-string; malformed.message, 'mount path must begin with /'
    duplicate-id = parse-config-yaml; 'mounts:\n  - controller: site\n    path: /\n  - controller: site\n    path: /other'
    assert-equal-string; duplicate-id.message, 'controller identifiers must be unique'
    duplicate-path = parse-config-yaml; 'mounts:\n  - controller: site\n    path: /same\n  - static-directory: public\n    path: /same'
    assert-equal-string; duplicate-path.message, 'mount paths must be unique'

function test-missing-configured-controller-is-explicit;
    parsed = parse-config-yaml; 'mounts:\n  - controller: site\n    path: /'
    assert-equal-bool; (parsed.config.controller-path; 'missing') == none, true
