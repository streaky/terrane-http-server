namespace streaky/http-server

from /deps/axum-core/body import Body as native-body
from /deps/axum-core/extract import Request as native-request
from /deps/http/request import Builder as request-builder
from /core/testing import assert-equal-bool, assert-equal-string, assert-equal-int
from /core/errors import throwable, coercion-error
from /core/collections import list

function test-request-extracts-decoded-path-and-form-query;
    builder = request-builder::new;
    builder = builder.uri; '/items/caf%C3%A9%2Btea?term=hello+world%26more%3Dyes&empty='
    request-body = native-body::empty;
    native = builder.body; move request-body
    request = instance http-request; move native, '/items/{id}'
    id = request.path-value; 'id'
    term = request.query-value; 'term'
    empty = request.query-value; 'empty'
    assert-equal-bool; id != none, true
    if id != none
        assert-equal-string; id, 'café+tea'
    assert-equal-bool; term != none, true
    if term != none
        assert-equal-string; term, 'hello world&more=yes'
    assert-equal-bool; empty != none, true
    if empty != none
        assert-equal-string; empty, ''
    assert-equal-bool; (request.query-value; 'missing') == none, true
    assert-equal-bool; (request.path-value; 'missing') == none, true

async function test-request-decodes-a-json-body throws throwable;
    native = native-request::new; (body-from-text; '{"quantity":3}')
    request = instance http-request; move native, '/'
    decoded = await request.json-body;
    quantity = decoded.field; 'quantity'
    assert-equal-bool; quantity.failed, false
    assert-equal-string; quantity.value.kind, 'integer'
    assert-equal-string; quantity.value.scalar, '3'

async function test-request-rejects-malformed-json;
    native = native-request::new; (body-from-text; '{broken')
    request = instance http-request; move native, '/'
    failed bool = false
    try
        await request.json-body;
    catch
        failed = true
    assert-equal-bool; failed, true


function test-http-error-rejects-success-and-invalid-statuses;
    for status in (list; 200, 399, 600)
        rejected bool = false
        try
            error = instance http-error; status
            assert-equal-string; (error.render;), 'unreachable'
        catch coercion-error
            rejected = true
        assert-equal-bool; rejected, true

function test-redirect-helper-rejects-nonredirect-status;
    rejected bool = false
    try
        response = create-redirect-response; '/', 404
        assert-equal-int; response.status, 303
    catch coercion-error
        rejected = true
    assert-equal-bool; rejected, true

function test-final-response-rejects-informational-statuses;
    for status in (list; 100, 101)
        rejected bool = false
        try
            into-native-response; (create-response; status, 'text/plain', '')
        catch coercion-error
            rejected = true
        assert-equal-bool; rejected, true

function test-repeated-accept-headers-preserve-specific-exclusions throws throwable;
    builder = request-builder::new;
    builder = builder.header; 'accept', 'application/json;q=0'
    builder = builder.header; 'accept', '*/*;q=1'
    native = builder.body; (native-body::empty;)
    request = instance http-request; move native, '/'
    selected = select-response-format; (request.accept-value;), (list; 'json', 'yaml'), 'json'
    assert-equal-string; selected, 'yaml'

function test-missing-and-empty-accept-headers-have-distinct-preferences throws throwable;
    missing = instance http-request; (native-request::new; (native-body::empty;)), '/'
    assert-equal-string; (select-response-format; (missing.accept-value;), (list; 'json', 'yaml'), 'yaml'), 'yaml'
    builder = request-builder::new;
    builder = builder.header; 'accept', ''
    empty = instance http-request; (builder.body; (native-body::empty;)), '/'
    assert-equal-string; (select-response-format; (empty.accept-value;), (list; 'json', 'yaml'), 'yaml'), ''

private function mixed-byte-accept-request native-request; exclude bool
    request native-request = rust
        let source: &[u8] = if exclude {
            b"application/json;q=0, text/\xe9, */*;q=1"
        } else {
            b"application/json, text/\xe9"
        };
        let accept = ::http::HeaderValue::from_bytes(source).expect("valid raw HTTP header bytes");
        ::http::Request::builder().header("accept", accept).body(::axum::body::Body::empty()).expect("request")
    return move request

function test-invalid-byte-range-does-not-hide-valid-ranges-or-exclusions throws throwable;
    for exclude in (list; false, true)
        request = instance http-request; (mixed-byte-accept-request; exclude), '/'
        expected = 'json'
        if exclude
            expected = 'yaml'
        assert-equal-string; (select-response-format; (request.accept-value;), (list; 'json', 'yaml'), 'json'), expected
