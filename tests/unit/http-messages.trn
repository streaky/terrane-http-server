namespace streaky/http-server/internal

from /deps/axum-core/body import Body as native-body
from /deps/axum/body import Bytes as native-bytes
from /deps/axum-core/extract import Request as native-request
from /deps/http/request import Builder as request-builder
from /core/testing import assert-equal-bool, assert-equal-string, assert-equal-int
from /core/errors import throwable, coercion-error
from /core/collections import list, range
from /core/documents/json import parse-json, default-json-options
from /streaky/http-server import api, response-context, http-error, request-body-limit, select-response-format

function test-request-extracts-decoded-path-and-form-query;
    builder = request-builder::new;
    builder = builder.uri; '/items/caf%C3%A9%2Btea?term=hello+world%26more%3Dyes&empty='
    request-body = native-body::empty;
    native = builder.body; move request-body
    request = instance incoming-request; move native, '/items/{id}'
    id = request.path-value; 'id'
    term = request.query-value; 'term'
    empty = request.query-value; 'empty'
    assert-equal-bool; id != none, true
    if id != none
        assert-equal-string; id, 'café+tea'
    assert-equal-bool; term != none, true
    if term != none
        assert-equal-string; term, 'hello world&more=yes'
    assert-equal-bool; empty != none, true
    if empty != none
        assert-equal-string; empty, ''
    assert-equal-bool; (request.query-value; 'missing') == none, true
    assert-equal-bool; (request.path-value; 'missing') == none, true

async function test-request-decodes-a-json-body throws throwable;
    native = native-request::new; (body-from-text; '{"quantity":3}')
    request = instance incoming-request; move native, '/'
    decoded = await request.json-body;
    quantity = decoded.field; 'quantity'
    assert-equal-bool; quantity.failed, false
    assert-equal-string; quantity.value.kind, 'integer'
    assert-equal-string; quantity.value.scalar, '3'

async function test-request-rejects-invalid-utf8-body throws throwable;
    invalid = native-bytes::from; b'{}\xff'
    native = native-request::new; (native-body::from; move invalid)
    request = instance incoming-request; move native, '/'
    failed bool = false
    try
        await request.json-body;
    catch coercion-error
        failed = true
    assert-equal-bool; failed, true

async function test-request-rejects-malformed-json;
    native = native-request::new; (body-from-text; '{broken')
    request = instance incoming-request; move native, '/'
    failed bool = false
    try
        await request.json-body;
    catch
        failed = true
    assert-equal-bool; failed, true

async function test-form-body-decodes-utf8-plus-and-duplicate-fields throws throwable;
    builder = request-builder::new;
    builder = builder.header; 'content-type', 'application/x-www-form-urlencoded; charset=utf-8'
    native = builder.body; (body-from-text; 'name=Jos%C3%A9+Smith&scope=read&scope=write&enabled=true&count=007&object%5Bx%5D=v&symbol=%23raw#fragment')
    request = instance incoming-request; move native, '/'
    decoded = await request.document-body; (list; 'json', 'form')
    name = decoded.field; 'name'
    scope = decoded.field; 'scope'
    assert-equal-string; name.value.kind, 'string'
    assert-equal-string; name.value.scalar, 'José Smith'
    assert-equal-string; scope.value.kind, 'list'
    assert-equal-int; (scope.value.length;), 2
    first = scope.value.item; 0
    second = scope.value.item; 1
    assert-equal-string; first.value.scalar, 'read'
    assert-equal-string; second.value.scalar, 'write'
    flag-field = decoded.field; 'enabled'
    count-field = decoded.field; 'count'
    bracket-field = decoded.field; 'object[x]'
    symbol-field = decoded.field; 'symbol'
    assert-equal-string; flag-field.value.kind, 'string'
    assert-equal-string; flag-field.value.scalar, 'true'
    assert-equal-string; count-field.value.scalar, '007'
    assert-equal-string; bracket-field.value.scalar, 'v'
    assert-equal-string; symbol-field.value.scalar, '#raw#fragment'

function test-form-body-groups-repeated-fields throws throwable;
    pairs list of string = list;
    for index in (range; 0, 256)
        pairs.append; 'same'
        pairs.append; (index.to-string;)
    document = form-document; pairs
    values = document.field; 'same'
    assert-equal-string; values.value.kind, 'list'
    assert-equal-int; (values.value.length;), 256
    first = values.value.item; 0
    last = values.value.item; 255
    assert-equal-string; first.value.scalar, '0'
    assert-equal-string; last.value.scalar, '255'

async function test-body-read-over-limit-keeps-limit-error;
    request = instance incoming-request; (native-request::new; (body-from-text; '123456')), '/'
    limited bool = false
    try
        await request.json-body; 2
    catch request-body-limit
        limited = true
    assert-equal-bool; limited, true

private function failing-body native-body;
    # Inject a native stream error rather than returning a large successful body.
    # The test needs a projected error item and an Axum body-stream constructor.
    return rust
        ::axum::body::Body::from_stream(::futures_util::stream::once(async {
            Err::<::axum::body::Bytes, std::io::Error>(std::io::Error::other("test body failure"))
        }))

async function test-body-read-transport-error-is-not-size-limit;
    request = instance incoming-request; (native-request::new; (failing-body;)), '/'
    limited bool = false
    failed bool = false
    try
        await request.json-body;
    catch request-body-limit
        limited = true
    catch http-error
        failed = true
    assert-equal-bool; limited, false
    assert-equal-bool; failed, true

async function test-form-body-rejects-malformed-escapes-and-utf8;
    for source in (list; 'name=%', 'name=%GG', 'name=%C3%28')
        builder = request-builder::new;
        builder = builder.header; 'content-type', 'application/x-www-form-urlencoded'
        native = builder.body; (body-from-text; source)
        request = instance incoming-request; move native, '/'
        rejected bool = false
        try
            await request.document-body; (list; 'form')
        catch
            rejected = true
        assert-equal-bool; rejected, true

async function test-document-body-distinguishes-unsupported-media-type;
    builder = request-builder::new;
    builder = builder.header; 'content-type', 'text/plain'
    native = builder.body; (body-from-text; 'x')
    request = instance incoming-request; move native, '/'
    rejected bool = false
    try
        await request.document-body; (list; 'json', 'form')
    catch http-error as error
        parsed-error = parse-json; error.message, (default-json-options;)
        status = parsed-error.value.field; 'status'
        rejected = status.value.scalar == '415'
    assert-equal-bool; rejected, true


function test-http-error-rejects-success-and-invalid-statuses;
    for status in (list; 200, 399, 600)
        rejected bool = false
        try
            _error = instance http-error; status
        catch coercion-error
            rejected = true
        assert-equal-bool; rejected, true

function test-redirect-helper-rejects-nonredirect-status;
    rejected bool = false
    try
        response = instance response-context;
        response.redirect; '/', 404
    catch coercion-error
        rejected = true
    assert-equal-bool; rejected, true

function test-final-response-rejects-informational-statuses;
    for status in (list; 100, 101)
        rejected bool = false
        try
            into-native-response; (encoded-response; status, 'text/plain', '')
        catch coercion-error
            rejected = true
        assert-equal-bool; rejected, true

function test-repeated-accept-headers-preserve-specific-exclusions throws throwable;
    builder = request-builder::new;
    builder = builder.header; 'accept', 'application/json;q=0'
    builder = builder.header; 'accept', '*/*;q=1'
    native = builder.body; (native-body::empty;)
    request = instance incoming-request; move native, '/'
    selected = select-response-format; (request.accept-value;), (list; 'json', 'yaml'), 'json'
    assert-equal-string; selected, 'yaml'

function test-missing-and-empty-accept-headers-have-distinct-preferences throws throwable;
    missing = instance incoming-request; (native-request::new; (native-body::empty;)), '/'
    assert-equal-string; (select-response-format; (missing.accept-value;), (list; 'json', 'yaml'), 'yaml'), 'yaml'
    builder = request-builder::new;
    builder = builder.header; 'accept', ''
    empty = instance incoming-request; (builder.body; (native-body::empty;)), '/'
    assert-equal-string; (select-response-format; (empty.accept-value;), (list; 'json', 'yaml'), 'yaml'), ''

private function mixed-byte-accept-request native-request; exclude bool
    # Construct a header with native obs-text amid valid Accept ranges.
    request native-request = rust
        let source: &[u8] = if exclude {
            b"application/json;q=0, text/\xe9, */*;q=1"
        } else {
            b"application/json, text/\xe9"
        };
        let accept = ::http::HeaderValue::from_bytes(source).expect("valid raw HTTP header bytes");
        ::http::Request::builder().header("accept", accept).header("accept", ", application/yaml;q=0.2,").body(::axum::body::Body::empty()).expect("request")
    return move request

function test-invalid-byte-range-does-not-hide-valid-ranges-or-exclusions throws throwable;
    for exclude in (list; false, true)
        request = instance incoming-request; (mixed-byte-accept-request; exclude), '/'
        expected = 'json'
        expected-raw = 'application/json,, application/yaml;q=0.2,'
        if exclude
            expected = 'yaml'
            expected-raw = 'application/json;q=0, */*;q=1,, application/yaml;q=0.2,'
        raw = request.accept-value;
        assert-equal-bool; raw != none, true
        if raw != none
            assert-equal-string; raw, expected-raw
        assert-equal-string; (select-response-format; (request.accept-value;), (list; 'json', 'yaml'), 'json'), expected

async function test-multipart-stages-fields-and-files-in-wire-order throws throwable;
    builder = request-builder::new;
    builder = builder.header; 'content-type', 'multipart/form-data; boundary=UploadBoundary'
    payload = "--UploadBoundary\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nhello\r\n--UploadBoundary\r\nContent-Disposition: form-data; name=\"attachment\"; filename=\"../../unsafe.txt\"\r\nContent-Type: text/plain\r\n\r\npayload-data\r\n--UploadBoundary--\r\n"
    native = builder.body; (body-from-text; payload)
    request = instance incoming-request; move native, '/'
    form = await request.multipart; 1024, 2
    assert-equal-int; form.parts.length, 2
    assert-equal-string; (ref form.parts[0]).name, 'title'
    titles = form.field-values; 'title'
    assert-equal-int; titles.length, 1
    assert-equal-string; titles[0], 'hello'
    parts = move form.parts
    attachment = parts.remove; 1
    assert-equal-string; attachment.name, 'attachment'
    file = move attachment.file
    assert-equal-bool; file != none, true
    if file != none
        assert-equal-string; file.filename, '../../unsafe.txt'
        path = file.claim;
        includes-client-name = (path.contains; 'unsafe.txt')
        assert-equal-bool; includes-client-name, false
        # Clean up only the claimed file and its immediate host parent. The
        # source path-parent helper normalizes path components before removal.
        cleaned bool = rust
            let path = std::path::Path::new(path.as_str());
            let content = std::fs::read(path);
            let file_removed = std::fs::remove_file(path).is_ok();
            let directory_removed = path.parent().is_some_and(|parent| std::fs::remove_dir(parent).is_ok());
            file_removed && directory_removed && content.is_ok_and(|bytes| bytes == b"payload-data")
        assert-equal-bool; cleaned, true

private function upload-with-non-utf8-path uploaded-file;
    # Source paths cannot represent the non-UTF-8 Unix filename this test needs.
    return rust
        use std::{ffi::OsStr, os::unix::ffi::OsStrExt as _};
        use terrane_platform_support::temporary::TemporaryPath as NativeTemporaryPath;
        let directory = NativeTemporaryPath::directory(None).unwrap();
        let parent = directory.path().join(OsStr::from_bytes(b"upload-\xff"));
        std::fs::create_dir(&parent).unwrap();
        let (file, _) = NativeTemporaryPath::file(Some(&parent)).unwrap();
        UploadedFile {
            temporary: Some(TemporaryPath::terrane_construct(Ok(file))),
            directory: Some(TemporaryPath::terrane_construct(Ok(directory))),
            filename: String::new(), media_type: None, size: 0,
        }

private function upload-still-staged bool; file ref uploaded-file
    # Inspect both native cleanup owners after rejection, before either is dropped.
    return rust
        let exists = |temporary: &TemporaryPath, directory: bool| {
            let entry = temporary.entry.as_ref().unwrap().as_ref().unwrap();
            if directory { entry.path().is_dir() } else { entry.path().is_file() }
        };
        file.temporary.as_ref().is_some_and(|entry| exists(entry, false)) &&
            file.directory.as_ref().is_some_and(|entry| exists(entry, true))

function test-multipart-claim-rejection-retains-staged-file throws throwable;
    file = upload-with-non-utf8-path;
    failed bool = false
    try
        file.claim;
    catch http-error
        failed = true
    assert-equal-bool; failed, true
    assert-equal-bool; (upload-still-staged; file), true

async function test-multipart-rejects-part-count-overflow;
    builder = request-builder::new;
    builder = builder.header; 'content-type', 'multipart/form-data; boundary=CountBoundary'
    payload = "--CountBoundary\r\nContent-Disposition: form-data; name=\"one\"\r\n\r\n1\r\n--CountBoundary\r\nContent-Disposition: form-data; name=\"two\"\r\n\r\n2\r\n--CountBoundary--\r\n"
    native = builder.body; (body-from-text; payload)
    request = instance incoming-request; move native, '/'
    rejected bool = false
    try
        await request.multipart; 1024, 1
    catch request-body-limit
        rejected = true
    assert-equal-bool; rejected, true

async function test-multipart-rejects-oversized-and-malformed-inputs;
    builder = request-builder::new;
    builder = builder.header; 'content-type', 'multipart/form-data; boundary=LimitBoundary'
    payload = "--LimitBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\ncontent-exceeds-limit\r\n--LimitBoundary--\r\n"
    native = builder.body; (body-from-text; payload)
    request = instance incoming-request; move native, '/'
    limited bool = false
    try
        await request.multipart; 10, 2
    catch request-body-limit
        limited = true
    assert-equal-bool; limited, true

    builder = request-builder::new;
    builder = builder.header; 'content-type', 'multipart/form-data'
    native = builder.body; (body-from-text; '')
    request = instance incoming-request; move native, '/'
    malformed bool = false
    try
        await request.multipart;
    catch coercion-error
        malformed = true
    assert-equal-bool; malformed, true
