namespace http-server-demo

from /core/collections import list

/// A catalog item and its price and availability.
class item-response
    /// Stable catalog identifier.
    id int
    /// Display name of the catalog item.
    name string
    /// Unit price in cents.
    price-cents int
    /// Stock availability; false also means stock details were not requested.
    in-stock bool

/// Search inputs and matching catalog items.
class search-response
    /// The search text supplied by the caller.
    term string
    /// The requested maximum result count.
    limit int
    /// Whether the search matched any catalog items.
    matches bool
    /// Matching items, each with its own price and availability.
    items list of item-response

/// Inputs for a stateless order price calculation.
class order-input
    /// Catalog identifier of the item to price.
    item-id int
    /// Number of units to price; defaults to zero and is not constrained to positive values.
    quantity int

/// A calculated quote, not a persisted order.
class quote-output
    /// Catalog identifier of the priced item.
    item-id int
    /// Number of units used in the calculation.
    quantity int
    /// Total price in cents, calculated as quantity times the item's unit price.
    total-cents int

function create-item-response item-response; id int, name string, price-cents int, in-stock bool
    value = instance item-response;
    value.id = id
    value.name = name
    value.price-cents = price-cents
    value.in-stock = in-stock
    return value

function create-search-response search-response; term string, limit int, matches bool, items list of item-response
    value = instance search-response;
    value.term = term
    value.limit = limit
    value.matches = matches
    value.items = items
    return value

function create-quote-output quote-output; item-id int, quantity int, total-cents int
    value = instance quote-output;
    value.item-id = item-id
    value.quantity = quantity
    value.total-cents = total-cents
    return value
