namespace http-server-demo

from /streaky/http-server/annotations import endpoint, route-group, static-directory
from /streaky/http-server import api
from /streaky/template import text-value
from /generated/template/http-server-demo import make-template-engine
from /core/errors import throwable

private function render-page string throws throwable; name string, title string, heading string
    engine = make-template-engine;
    engine.assign; 'title', (text-value; title)
    engine.assign; 'heading', (text-value; heading)
    return engine.fetch; name

@[route-group; prefix = '/', document = false]
@[static-directory; path = '/docs', directory = 'public/docs']
@[static-directory; path = '/assets', directory = 'public/assets']
class site uses api
    private note string = 'Terrane catalog API\n'
    private note-size int

    function construct;
        # Cache the encoded UTF-8 byte length once, not during HEAD.
        this.note-size = this.note.bytes.length

    @[endpoint; method = 'GET', path = '/', content-type = 'text/html', summary = 'Catalog home']
    async function home string throws throwable;
        return render-page; 'home.html', 'Terrane Catalog', 'Terrane Catalog'

    @[endpoint; method = 'GET', path = '/about', content-type = 'text/html', summary = 'About the catalog demo']
    async function about string throws throwable;
        return render-page; 'about.html', 'About — Terrane Catalog', 'About this demo'

    @[endpoint; method = 'GET', path = '/websocket', content-type = 'text/html', summary = 'WebSocket playground']
    async function websocket-playground string throws throwable;
        return render-page; 'websocket.html', 'WebSocket — Terrane Catalog', 'WebSocket playground'

    @[endpoint; method = 'GET|HEAD', path = '/catalog-note', content-type = 'text/plain']
    async function catalog-note string|none;
        request = this.request
        response = this.response
        if request != none
            if response != none
                response.set-status; 200
                response.set-content-type; 'text/plain'
                if (request.method;) == 'HEAD'
                    response.set-content-length; this.note-size
                    return none
        return this.note

    @[endpoint; method = 'GET', path = '/catalog']
    async function catalog-redirect none;
        response = this.response
        if response != none
            response.redirect; '/'
        return none
