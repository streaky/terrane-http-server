namespace http-server-demo

from /streaky/http-server import create-application
from /generated/http-server import mount-annotated
from /core/errors import throwable
from /core/process import arguments
from /core/networking import listen-tcp

async function main throws throwable;
    app = create-application;
    app = mount-annotated; move app
    app = app.websocket; '/ws/echo', echo-session
    address = '127.0.0.1:3187'
    supplied = arguments;
    for argument in supplied
        if argument.text != '--oauth'
            address = argument.text
    listener = await listen-tcp; address
    print; 'Catalog demo: http://' + listener.local-address + '/'
    await app.serve-listener; move listener
