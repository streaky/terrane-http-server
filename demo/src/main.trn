namespace http-server-demo

from /http-server import create-application
from /generated/http-server import mount-annotated
from /core/errors import throwable
from /core/process import arguments

async function main throws throwable;
    app = create-application;
    app = mount-annotated; move app
    address = '127.0.0.1:3187'
    supplied = arguments;
    if supplied.length > 0
        address = supplied[0].text
    app = app.with-address; address
    print; ('Catalog demo: http://'.concat; address, '/')
    await app.serve;
