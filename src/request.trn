namespace streaky/http-server

from /deps/axum/body import to_bytes as body-to-bytes
from /deps/axum-core/extract import Request as native-request
from /deps/axum-core/body import Body as native-body
from /deps/axum-core/response import Response as native-response
from /deps/http import StatusCode as status-code
from /deps/http/response import Builder as response-builder
from /deps/http/uri import PathAndQuery as path-and-query
from /deps/axum/body import Bytes as native-bytes
from /core/collections import list
from /core/documents import document-value
from /core/documents/json import default-json-options, parse-json
from /core/urls import url-query, parse-url
from /core/errors import throwable, coercion-error

public class http-request
    private names list of string = list
    private values list of string = list
    private query url-query = instance url-query;
    private body native-body|none = none

    private function construct; request native-request, route-pattern string
        uri = (request.uri;).clone;
        actual-path = uri.path;
        pattern-segments = route-pattern.split; '/'
        actual-segments = actual-path.split; '/'
        index int = 0
        while index < pattern-segments.length and index < actual-segments.length
            segment = pattern-segments[index]
            if segment.contains.start; '{'
                name = segment.replace; (list; '{', '}'), ''
                decoded = decode-path-component; actual-segments[index]
                if not decoded.failed
                    this.names.append; move name
                    this.values.append; move decoded.value
                else
                    throw coercion-error
            index = index + 1
        target path-and-query|none = (uri.path_and_query;).cloned;
        address = 'http://localhost/'
        if target != none
            address = 'http://localhost' + (target.as_str;)
        parsed = parse-url; address
        if parsed.failed
            throw coercion-error
        this.query = parsed.value.query
        this.body = request.into_body;

    function path-value string|none; name string
        index int = 0
        while index < this.names.length
            if this.names[index] == name
                return this.values[index]
            index = index + 1
        return none

    function query-value string|none; name string
        index int = 0
        while index < this.query.keys.length
            if this.query.keys[index] == name
                return this.query.values[index]
            index = index + 1
        return none

    consuming async function json-body document-value throws throwable;
        body = move this.body
        if body != none
            buffered = await body-to-bytes; move body, 2097152
            source = buffer-into-text; buffered
            if not source.failed
                parsed = parse-json; source.value, (default-json-options;)
                if parsed.failed
                    throw coercion-error
                return parsed.value
        throw coercion-error

public class http-response
    status int = 200
    content-type string = 'text/plain; charset=utf-8'
    body string = ''
    headers list of http-header

    function construct; status int, content-type string, body string
        this.status = status
        this.content-type = content-type
        this.body = body

    consuming function with-header http-response; name string, value string
        this.headers.append; (instance http-header; name, value)
        return move this


function into-native-response native-response throws throwable; response http-response
    if response.status < 200 or response.status > 599
        throw coercion-error
    code = status-code::from_u16; response.status
    builder = response-builder::new;
    builder = builder.status; code
    content-type = response.content-type
    for header in response.headers
        if header-name-is-content-type; header.name
            content-type = header.value
        else
            builder = builder.header; header.name, header.value
    builder = builder.header; 'content-type', move content-type
    return builder.body; (body-from-text; move response.body)

private function header-name-is-content-type bool; name string
    matched bool = rust
        name.eq_ignore_ascii_case("content-type")
    return matched

public function create-response http-response; status int, content-type string, body string
    return instance http-response; status, content-type, body

# Typed boundaries for the package-owned conversion module; it supplies no HTTP policy.
class decoded-text
    value string = ''
    failed bool = true

function body-from-text native-body; text string
    return rust
        crate::conversions::body_from_text(text)

function buffer-into-text decoded-text; buffer native-bytes
    return rust
        match crate::conversions::buffer_into_text(buffer) {
            Some(value) => DecodedText { value, failed: false },
            None => DecodedText { value: String::new(), failed: true },
        }

function decode-path-component decoded-text; value string
    return rust
        match crate::conversions::decode_path_component(value) {
            Some(value) => DecodedText { value, failed: false },
            None => DecodedText { value: String::new(), failed: true },
        }
