public class uploaded-file
    private temporary temp-path|none = none
    private directory temp-dir|none = none
    filename string = ''
    media-type string|none = none
    size uint64 = 0

    mutable function claim string throws throwable;
        if this.temporary == none or this.directory == none
            throw coercion-error
        valid-path bool = rust
            self.temporary.as_ref().expect("checked temporary").to_str().is_some()
        if not valid-path
            throw http-error; 500, 'Multipart upload path is not valid UTF-8'
        # Transfer the two non-Clone cleanup owners only after validation.
        # The initialized optional fields need consuming extraction together.
        path string|none = rust
            let temporary = self.temporary.take().expect("checked temporary");
            let directory = self.directory.take().expect("checked directory");
            match temporary.keep() {
                Ok(path) => {
                    directory.keep();
                    Some(path.into_os_string().into_string().expect("path checked before transfer"))
                }
                Err(_) => { drop(directory); None }
            }
        if path != none
            return path
        throw http-error; 500, 'Unable to transfer multipart upload'

public class multipart-part
    name string = ''
    value string|none = none
    file uploaded-file|none = none

public class multipart-form
    parts list of multipart-part = list

    function field-values list of string; name string
        values list of string = list
        for part in ref this.parts
            if part.name == name
                value = part.value
                if value != none
                    values.append; value
        return values

public class incoming-request
    private names list of string = list
    private values list of string = list
    private query url-query = instance url-query;
    private body native-body|none = none
    private accept string|none = none
    private metadata request-context
    private response response-context
    private content-type string|none = none
    private bytes-read uint64 = 0

    function construct; request native-request, route-pattern string
        this.metadata = capture-request-context; request, route-pattern
        this.response = instance response-context;
        uri = (request.uri;).clone;
        actual-path = uri.path;
        pattern-segments = route-pattern.split; '/'
        actual-segments = actual-path.split; '/'
        index int = 0
        while index < pattern-segments.length and index < actual-segments.length
            segment = pattern-segments[index]
            if segment.contains.start; '{'
                name = segment.replace; (list; '{', '}'), ''
                decoded = decode-path-component; actual-segments[index]
                if decoded.failed
                    throw coercion-error
                this.names.append; move name
                this.values.append; move decoded.value
            index = index + 1
        target path-and-query|none = (uri.path_and_query;).cloned;
        address = 'http://localhost/'
        if target != none
            address = 'http://localhost' + (target.as_str;)
        parsed = parse-url; address
        if parsed.failed
            throw coercion-error
        this.query = parsed.value.query
        if request-has-accept-header; request
            this.accept = request-accept-header; request
        this.content-type = this.metadata.header-value; 'content-type'
        this.body = request.into_body;

    function context request-context;
        return this.metadata

    function response-state response-context;
        return this.response

    function accept-value string|none;
        return this.accept

    function path-value string|none; name string
        index int = 0
        while index < this.names.length
            if this.names[index] == name
                return this.values[index]
            index = index + 1
        return none

    function query-value string|none; name string
        index int = 0
        while index < this.query.keys.length
            if this.query.keys[index] == name
                return this.query.values[index]
            index = index + 1
        return none

    mutable async function json-body document-value throws throwable; maximum-bytes uint64 = 2097152, timeout-ms uint64 = 0, maximum-depth uint32 = 256
        body = move this.body
        buffered = await bounded-body-to-bytes; body, maximum-bytes, timeout-ms
        this.bytes-read = buffered.len;
        source = buffer-into-text; move buffered
        if not source.failed
            options = default-json-options;
            options.max-depth = maximum-depth
            options.max-bytes = maximum-bytes
            parsed = parse-json; source.value, options
            if not parsed.failed
                return parsed.value
        throw coercion-error

    mutable async function document-body document-value throws throwable; formats list of string, maximum-bytes uint64 = 2097152, timeout-ms uint64 = 0, maximum-depth uint32 = 256
        format = select-request-format; this.content-type, formats
        body = move this.body
        buffered = await bounded-body-to-bytes; body, maximum-bytes, timeout-ms
        this.bytes-read = buffered.len;
        source = buffer-into-text; move buffered
        if source.failed
            throw coercion-error
        if format == 'json'
            options = default-json-options;
            options.max-depth = maximum-depth
            options.max-bytes = maximum-bytes
            parsed = parse-json; source.value, options
            if parsed.failed
                throw coercion-error
            return parsed.value
        pairs = decode-form-pairs; source.value
        if pairs != none
            return form-document; pairs
        throw coercion-error

    mutable async function multipart multipart-form throws throwable; maximum-bytes uint64 = 16777216, maximum-parts uint32 = 32, timeout-ms uint64 = 0
        content-type = this.content-type
        if content-type != none
            body = move this.body
            staged = await stage-multipart-body; body, content-type, maximum-bytes, maximum-parts, timeout-ms
            this.bytes-read = staged.bytes-read
            form = move staged.form
            if form != none
                return move form
        throw http-error; 415, 'Multipart Content-Type is required'

    function body-byte-count uint64;
        return this.bytes-read

public class wire-response
    status int
    content-type string
    body string
    headers map of string, (list of string) = map
    structured bool = false
    supplied bool = true
    stream response-stream|none = none

    function construct; status int, content-type string, body string, structured bool = false
        this.status = status
        this.content-type = content-type
        this.body = body
        this.structured = structured
        this.supplied = status != 204
        this.stream = none
public function encoded-response wire-response; status int, content-type string, body string
    return instance wire-response; status, content-type, body

public function encode-document-response wire-response throws throwable; document document-value, format string
    return instance wire-response; 200, (response-media-type; format), (encode-response-document; document, format), true

public function into-native-response native-response throws throwable; response wire-response, vary-accept bool = false, is-head bool = false
    if response.status < 200 or response.status > 599
        throw coercion-error
    if vary-accept
        covered bool = false
        values = response.headers.get.checked; 'vary'
        if values != none
            for value in values
                if header-varies-accept; value
                    covered = true
        if not covered
            additions list of string = list
            if values != none
                additions = values
            additions.append; 'Accept'
            response.headers.set; 'vary', additions
    length-values = response.headers.get.checked; 'content-length'
    if length-values != none
        if length-values.length != 1
            throw coercion-error
        length int = length-values[0].radix; 10
        if length < 0
            throw coercion-error
        if response.stream == none and not is-head and response.supplied and length != (body-byte-length; response.body)
            throw coercion-error
    code status-code = status-code::from_u16; response.status
    builder response-builder = response-builder::new;
    builder = builder.status; code
    if response.content-type != ''
        builder = builder.header; 'content-type', response.content-type
    for name, header-values in response.headers
        for header-value in header-values
            builder = builder.header; name, header-value
    producer = response.stream
    if producer != none
        if is-head or response.status == 204 or response.status == 205 or response.status == 304
            producer.cancel;
            return builder.body; (metadata-only-body;)
        next = async function (string|none);
            return await producer.next-chunk;
        cancel = function none;
            producer.cancel;
            return none
        return builder.body; (body-from-stream; next, cancel)
    if is-head and not response.supplied and length-values == none and response.status != 204 and response.status != 205
        return builder.body; (metadata-only-body;)
    return builder.body; (body-from-text; move response.body)

public function native-status-response native-response; status status-code, vary bool
    response native-response = status.into_response;
    if vary
        name = native-header-name::from_static; 'vary'
        value = native-header-value::from_static; 'Accept'
        (response.headers_mut;).append; name, value
    return move response

private function body-byte-length int; text ref string
    return text.bytes.length

private function header-varies-accept bool; value ref string
    for token in (value.split; ',')
        trimmed = token.trim;
        if trimmed == '*' or (trimmed.lower;) == 'accept'
            return true
    return false

private function request-has-accept-header bool; request ref native-request
    return (request.headers;).contains_key; 'accept'

private function request-accept-header string; request ref native-request
    # Validate comma-separated borrowed byte ranges independently before joining;
    # a whole-value conversion discards valid ranges beside malformed bytes.
    result string = rust
        let mut combined = String::new();
        for value in request.headers().get_all("accept").iter() {
            for range in value.as_bytes().split(|byte| *byte == b',') {
                if !range.iter().all(|byte| *byte == b'\t' || (b' '..=b'~').contains(byte)) { continue; }
                if let Ok(text) = std::str::from_utf8(range) {
                    if !combined.is_empty() { combined.push(','); }
                    combined.push_str(text);
                }
            }
        }
        combined
    return result

class decoded-text
    value string = ''
    failed bool = true

class body-read-result
    buffer native-bytes = native-bytes::new;
    failed bool = false
    timed-out bool = false
    limited bool = false
    missing bool = false
# The optional slot makes ownership explicit without reading an owned non-Clone
# native body directly from inline Rust.
private async function bounded-body-to-bytes native-bytes throws throwable; body mutable ref (native-body|none), maximum uint64, timeout-ms uint64
    # Take a non-Clone Body once and keep the native collector's outcome categories.
    result body-read-result = rust
        match body.take() {
            None => BodyReadResult { buffer: ::axum::body::Bytes::new(), failed: false, timed_out: false, limited: false, missing: true },
            Some(body) => match crate::conversions::bounded_body_to_bytes(
                body, usize::try_from(maximum).unwrap_or(usize::MAX), timeout_ms
            ).await {
                Ok(buffer) => BodyReadResult { buffer, failed: false, timed_out: false, limited: false, missing: false },
                Err(status) => BodyReadResult { buffer: ::axum::body::Bytes::new(), failed: status == 400, timed_out: status == 408, limited: status == 413, missing: false },
            },
        }
    if result.missing
        throw coercion-error
    if result.timed-out
        throw request-body-timeout
    if result.limited
        throw request-body-limit
    if result.failed
        throw http-error; 400, 'Unable to read request body'
    return result.buffer

class multipart-stage-result
    form multipart-form|none = none
    bytes-read uint64 = 0
    error-status uint16 = 0

private async function stage-multipart-body multipart-stage-result throws throwable; body mutable ref (native-body|none), content-type ref string, maximum uint64, maximum-parts uint32, timeout-ms uint64
    # Bridge native streaming output and move both temporary owners into each file.
    result multipart-stage-result = rust
        match body.take() {
            None => MultipartStageResult { form: None, bytes_read: 0, error_status: 400 },
            Some(body) => match crate::multipart::stage(body, content_type, maximum, maximum_parts, timeout_ms).await {
                Ok(staged) => {
                    let bytes_read = staged.bytes_read;
                    let parts = staged.parts.into_iter().map(|part| {
                        let file = part.temporary.map(|(temporary, directory)| UploadedFile {
                            temporary: Some(temporary), directory: Some(directory),
                            filename: part.filename.unwrap_or_default(),
                            media_type: part.media_type, size: part.size,
                        });
                        MultipartPart { name: part.name, value: part.value, file }
                    }).collect();
                    MultipartStageResult {
                        form: Some(MultipartForm { parts: terrane_collection_support::List::new(parts) }),
                        bytes_read, error_status: 0,
                    }
                }
                Err(error) => MultipartStageResult {
                    form: None, bytes_read: 0, error_status: match error {
                        crate::multipart::StageError::Malformed => 400,
                        crate::multipart::StageError::Timeout => 408,
                        crate::multipart::StageError::Limit => 413,
                        crate::multipart::StageError::Unsupported => 415,
                        crate::multipart::StageError::Storage => 500,
                    },
                },
            },
        }
    if result.error-status == 408
        throw request-body-timeout
    if result.error-status == 413
        throw request-body-limit
    if result.error-status == 400
        throw coercion-error
    if result.error-status == 415
        throw http-error; 415, 'Multipart Content-Type is required'
    if result.error-status == 500
        throw http-error; 500, 'Unable to stage multipart upload'
    return result

private function body-from-stream native-body; next async function to (string|none) throws throwable, cancel function to none
    # The native poll-driven body needs the exact async callable ABI and drop hook.
    return rust
        crate::conversions::streaming_body(move || next(), move || cancel())

private function body-from-text native-body; text string
    return native-body::from; move text

private function metadata-only-body native-body;
    # HEAD without an explicit length requires an unknown native Body size hint.
    return rust
        crate::conversions::metadata_only_body()

private function buffer-into-text decoded-text; buffer native-bytes
    octets bytes = (move buffer).into;
    try
        text = (move octets).decode; utf8
        return instance decoded-text; {
            value = move text
            failed = false
        }
    catch decode-error
        return instance decoded-text;

private function decode-path-component decoded-text; value string
    # Keep Cow's unchanged branch as the original owned text and reject invalid UTF-8.
    return rust
        match crate::conversions::decode_path_component(value) {
            Some(value) => DecodedText { value, failed: false },
            None => DecodedText { value: String::new(), failed: true },
        }

private function select-request-format string; content-type string|none, formats list of string
    if content-type != none
        parts = content-type.split; ';'
        media = (parts[0].trim;).lower;
        selected string = ''
        if media == 'application/json'
            selected = 'json'
        else if media == 'application/x-www-form-urlencoded'
            selected = 'form'
            if parts.length > 2
                throw http-error; 415, 'Unsupported form Content-Type parameters'
            if parts.length == 2
                parameter = (parts[1].trim;).lower;
                if parameter != 'charset=utf-8' and parameter != 'charset="utf-8"'
                    throw http-error; 415, 'Unsupported form charset'
        for candidate in formats
            if candidate == selected
                return selected
    throw http-error; 415, 'A supported request Content-Type is required'

private function form-document document-value; pairs ref (list of string)
    grouped unordered-map of string, (list of string) = unordered-map;
    keys list of string = list;
    position int = 0
    pair-count = pairs.length
    while position < pair-count
        key = pairs[position]
        previous = grouped.remove.checked; key
        if previous != none
            repeated = previous
            repeated.append; pairs[position + 1]
            grouped.set; key, move repeated
        else
            keys.append; key
            repeated list of string = list; pairs[position + 1]
            grouped.set; key, move repeated
        position = position + 2
    entries = instance document-map-entries;
    for key in keys
        strings = grouped.get.checked; key
        if strings != none
            documents list of document-value = list;
            for text in strings
                documents.append; (make-document-string; text)
            field document-value
            if documents.length == 1
                field = documents[0]
            else
                sequence = make-document-list; documents
                if sequence.failed
                    throw coercion-error
                field = sequence.value
            entries.append; key, field
    result = make-document-map; entries
    if result.failed
        throw coercion-error
    return result.value

# Core URL queries are permissive about malformed escapes/UTF-8 and URL parsing
# alters raw controls/fragments. Decode only ordered form components here; source
# code above owns duplicate grouping and documents. Remove when core provides
# strict form-component decoding with equivalent byte and error semantics.
private function decode-form-pairs (list of string)|none; source ref string
    return rust
        let hex = |value: u8| -> Option<u8> {
            match value {
                b'0'..=b'9' => Some(value - b'0'),
                b'a'..=b'f' => Some(value - b'a' + 10),
                b'A'..=b'F' => Some(value - b'A' + 10),
                _ => None,
            }
        };
        let component = |input: &[u8]| -> Option<String> {
            let mut decoded = Vec::with_capacity(input.len());
            let mut position = 0;
            while position < input.len() {
                match input[position] {
                    b'+' => { decoded.push(b' '); position += 1; }
                    b'%' => {
                        let high = hex(*input.get(position + 1)?)?;
                        let low = hex(*input.get(position + 2)?)?;
                        decoded.push(high * 16 + low);
                        position += 3;
                    }
                    byte => { decoded.push(byte); position += 1; }
                }
            }
            String::from_utf8(decoded).ok()
        };
        let mut result = Vec::new();
        for pair in source.as_bytes().split(|byte| *byte == b'&').filter(|pair| !pair.is_empty()) {
            let split = pair.iter().position(|byte| *byte == b'=').unwrap_or(pair.len());
            result.push(component(&pair[..split])?);
            result.push(component(if split < pair.len() { &pair[split + 1..] } else { &[] })?);
        }
        Some(terrane_collection_support::List::new(result))
