namespace streaky/http-server/internal

from /deps/axum/body import to_bytes as body-to-bytes, Bytes as native-bytes
from /deps/axum-core/extract import Request as native-request
from /deps/axum-core/body import Body as native-body
from /deps/axum-core/response import Response as native-response
from /deps/http import StatusCode as status-code
from /deps/http/response import Builder as response-builder
from /deps/http/uri import PathAndQuery as path-and-query
from /core/collections import list, map
from /core/documents import document-value
from /core/documents/json import parse-json, default-json-options
from /core/urls import url-query, parse-url
from /core/errors import throwable, coercion-error
from /streaky/http-server import request-context, response-context, capture-request-context, response-media-type, encode-response-document

public class incoming-request
    private names list of string = list
    private values list of string = list
    private query url-query = instance url-query;
    private body native-body|none = none
    private accept string|none = none
    private metadata request-context
    private response response-context

    function construct; request native-request, route-pattern string
        this.metadata = capture-request-context; ref request, route-pattern
        this.response = instance response-context;
        uri = (request.uri;).clone;
        actual-path = uri.path;
        pattern-segments = route-pattern.split; '/'
        actual-segments = actual-path.split; '/'
        index int = 0
        while index < pattern-segments.length and index < actual-segments.length
            segment = pattern-segments[index]
            if segment.contains.start; '{'
                name = segment.replace; (list; '{', '}'), ''
                decoded = decode-path-component; actual-segments[index]
                if decoded.failed
                    throw coercion-error
                this.names.append; move name
                this.values.append; move decoded.value
            index = index + 1
        target path-and-query|none = (uri.path_and_query;).cloned;
        address = 'http://localhost/'
        if target != none
            address = 'http://localhost' + (target.as_str;)
        parsed = parse-url; address
        if parsed.failed
            throw coercion-error
        this.query = parsed.value.query
        if request-has-accept-header; ref request
            this.accept = request-accept-header; ref request
        this.body = request.into_body;

    function context request-context;
        return this.metadata

    function response-state response-context;
        return this.response

    function accept-value string|none;
        return this.accept

    function path-value string|none; name string
        index int = 0
        while index < this.names.length
            if this.names[index] == name
                return this.values[index]
            index = index + 1
        return none

    function query-value string|none; name string
        index int = 0
        while index < this.query.keys.length
            if this.query.keys[index] == name
                return this.query.values[index]
            index = index + 1
        return none

    consuming async function json-body document-value throws throwable;
        body = move this.body
        if body != none
            buffered = await body-to-bytes; move body, 2097152
            source = buffer-into-text; buffered
            if not source.failed
                parsed = parse-json; source.value, (default-json-options;)
                if not parsed.failed
                    return parsed.value
        throw coercion-error

public class wire-response
    status int
    content-type string
    body string
    headers map of string, (list of string) = map
    structured bool = false
    supplied bool = true

    function construct; status int, content-type string, body string, structured bool = false
        this.status = status
        this.content-type = content-type
        this.body = body
        this.structured = structured
        this.supplied = status != 204

public function encoded-response wire-response; status int, content-type string, body string
    return instance wire-response; status, content-type, body

public function encode-document-response wire-response throws throwable; document document-value, format string
    return instance wire-response; 200, (response-media-type; format), (encode-response-document; document, format), true

public function into-native-response native-response throws throwable; response wire-response, vary-accept bool = false, is-head bool = false
    if response.status < 200 or response.status > 599
        throw coercion-error
    if vary-accept
        covered bool = false
        values = response.headers.get.checked; 'vary'
        if values != none
            for value in values
                if header-varies-accept; ref value
                    covered = true
        if not covered
            additions list of string = list
            if values != none
                additions = values
            additions.append; 'Accept'
            response.headers.set; 'vary', additions
    length-values = response.headers.get.checked; 'content-length'
    if length-values != none
        if length-values.length != 1
            throw coercion-error
        length int = length-values[0].radix; 10
        if length < 0
            throw coercion-error
        if not is-head and response.supplied and length != (body-byte-length; ref response.body)
            throw coercion-error
    code status-code = status-code::from_u16; response.status
    builder response-builder = response-builder::new;
    builder = builder.status; code
    if response.content-type != ''
        builder = builder.header; 'content-type', response.content-type
    for name, header-values in response.headers
        for header-value in header-values
            builder = builder.header; name, header-value
    if is-head and not response.supplied and length-values == none and response.status != 204 and response.status != 205
        return builder.body; (metadata-only-body;)
    return builder.body; (body-from-text; move response.body)

public function native-status-response native-response; status status-code, vary bool
    response native-response = rust
        let mut response = ::axum::response::IntoResponse::into_response(status);
        if vary {
            response.headers_mut().append(::http::header::VARY, ::http::HeaderValue::from_static("Accept"));
        }
        response
    return move response

private function body-byte-length int; text ref string
    return text.bytes.length

private function header-varies-accept bool; value ref string
    result bool = rust
        value.split(',').any(|token| token.trim().eq_ignore_ascii_case("accept") || token.trim() == "*")
    return result

private function request-has-accept-header bool; request ref native-request
    return (request.headers;).contains_key; 'accept'

private function request-accept-header string; request ref native-request
    result string = rust
        let mut combined = String::new();
        for value in request.headers().get_all("accept").iter() {
            for range in value.as_bytes().split(|byte| *byte == b',') {
                if !range.iter().all(|byte| *byte == b'\t' || (b' '..=b'~').contains(byte)) { continue; }
                if let Ok(text) = std::str::from_utf8(range) {
                    if !combined.is_empty() { combined.push(','); }
                    combined.push_str(text);
                }
            }
        }
        combined
    return result

class decoded-text
    value string = ''
    failed bool = true

private function body-from-text native-body; text string
    return rust
        crate::conversions::body_from_text(text)

private function metadata-only-body native-body;
    return rust
        crate::conversions::metadata_only_body()

private function buffer-into-text decoded-text; buffer native-bytes
    return rust
        match crate::conversions::buffer_into_text(buffer) {
            Some(value) => DecodedText { value, failed: false },
            None => DecodedText { value: String::new(), failed: true },
        }

private function decode-path-component decoded-text; value string
    return rust
        match crate::conversions::decode_path_component(value) {
            Some(value) => DecodedText { value, failed: false },
            None => DecodedText { value: String::new(), failed: true },
        }
