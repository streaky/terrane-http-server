namespace streaky/http-server

from /core/collections import list, map
from /core/errors import throwable, coercion-error
from /core/documents import make-document-string
from /core/documents/json import canonical-json
from /streaky/http-server/internal import wire-response

/// Mutable instructions for one response, shared only within one invocation.
public class response-context
    private settings shared ref response-settings = shared ref (instance response-settings;)

    function set-status; status int
        state = this.settings
        state.change-status; status

    function set-header; name string, value string
        state = this.settings
        state.change-header; name, value, false

    function add-header; name string, value string
        state = this.settings
        state.change-header; name, value, true

    function set-content-type; value string
        this.set-header; 'content-type', value

    function set-content-length; length int
        if length < 0
            throw coercion-error
        this.set-header; 'content-length', (length.to-string;)

    function vary; value string
        this.add-header; 'vary', value

    function redirect; location string, status int = 303
        if status != 301 and status != 302 and status != 303 and status != 307 and status != 308
            throw coercion-error
        this.set-status; status
        this.set-header; 'location', location

    function set-cookie; name string, value string
        check-cookie; name, value
        this.add-header; 'set-cookie', (name + '=' + value + '; Path=/; HttpOnly; SameSite=Lax')

    function clear-cookie; name string
        check-cookie; name, ''
        this.add-header; 'set-cookie', (name + '=; Path=/; Max-Age=0; HttpOnly; SameSite=Lax')

    # Internal finalization takes one atomic snapshot and closes all retained aliases.
    function finish wire-response; response wire-response
        state = this.settings
        overrides = state.complete;
        status = overrides.status
        if status != none
            response.status = status
        for name, values in overrides.headers
            if name == 'content-type'
                selected = values[values.length - 1]
                if response.structured and selected != response.content-type
                    throw coercion-error
                response.content-type = selected
            else
                response.headers.set; name, values
        if response.status == 204 or response.status == 205
            response.body = ''
            response.content-type = ''
            response.supplied = false
            response.headers.remove.checked; 'content-length'
        else if response.status == 304
            response.body = ''
            response.supplied = false
        return move response

    function discard;
        state = this.settings
        state.close;

class response-settings
    status int|none = none
    headers map of string, (list of string) = map
    private closed bool = false

    mutable function change-status; status int
        this.ensure-open;
        if status < 200 or status > 599
            throw coercion-error
        this.status = status

    mutable function change-header; name string, value string, append bool
        this.ensure-open;
        checked-header; name, value
        key = name.lower;
        values list of string = list
        if append
            previous = this.headers.get.checked; key
            if previous != none
                values = previous
        values.append; value
        this.headers.set; key, values

    mutable function complete response-settings;
        this.ensure-open;
        this.closed = true
        return this

    mutable function close;
        this.closed = true

    private function ensure-open;
        if this.closed
            throw coercion-error

private function checked-header; name string, value string
    valid bool = rust
        ::http::header::HeaderName::from_bytes(name.as_bytes()).is_ok()
            && ::http::HeaderValue::from_str(&value).is_ok()
    if not valid
        throw coercion-error

private function check-cookie; name string, value string
    valid bool = rust
        !name.is_empty() && name.bytes().all(|b| b.is_ascii_alphanumeric() || b"!#$%&'*+-.^_`|~".contains(&b))
            && value.bytes().all(|b| b == 0x21 || (0x23..=0x2b).contains(&b)
                || (0x2d..=0x3a).contains(&b) || (0x3c..=0x5b).contains(&b)
                || (0x5d..=0x7e).contains(&b))
    if not valid
        throw coercion-error

/// Error status and text only. Success/redirect control belongs to this.response.
public class http-error implements throwable
    message string = ''
    private status int
    private detail string

    function construct; status int, detail string = ''
        if status < 400 or status > 599
            throw coercion-error
        this.status = status
        this.detail = detail
        # Throwable catch bindings expose the interface's message, not concrete fields.
        encoded = canonical-json; (make-document-string; detail)
        if encoded.failed
            throw coercion-error
        this.message = '{"status":' + status + ',"detail":' + encoded.value.encoded + '}'

    function status-code int;
        return this.status

    function render string;
        return 'HTTP ' + this.status + ': ' + this.detail
