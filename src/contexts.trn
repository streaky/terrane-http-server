namespace streaky/http-server

from /core/collections import list
from /core/encodings import utf8
from /core/errors import coercion-error, decode-error
from /deps/axum-core/extract import Request as native-request
from /deps/ipnet import IpAddr as ip-addr
from /deps/axum/extract import MatchedPath as matched-path, OriginalUri as original-uri
from /deps/http import HeaderMap as native-header-map, HeaderValue as native-header-value
from /deps/http/header import ToStrError as header-text-error
from /deps/http/uri import Authority as native-authority, PathAndQuery as native-path-and-query

/// Adds optional invocation context without imposing a base class or handler parameters.
public trait api
    request request-context|none = none
    response response-context|none = none

/// An immutable snapshot. It never owns or buffers the request body.
public class request-context
    private verb string
    private original-target string
    private original-path string
    private pattern string
    private version string
    private origin-scheme string|none = none
    private origin-authority string|none = none
    private peer ip-addr|none = none
    private client ip-addr|none = none
    private trusted bool = false
    private headers shared ref (native-header-map of native-header-value)

    private function construct; request ref native-request, route-pattern string
        this.verb = request-method; request
        this.original-target = request-target; request
        this.original-path = request-path; request
        this.pattern = request-route-pattern; request, route-pattern
        this.version = request-version; request
        this.peer = direct-address; request
        this.client = client-address; request
        this.trusted = request-proxy-trust; request
        captured native-header-map of native-header-value = (request.headers;).clone;
        this.headers = shared ref captured
        this.origin-authority = request-authority; request
        this.origin-scheme = 'http'
        if this.trusted
            this.origin-scheme = forwarded-scheme; this

    function method string;
        return this.verb

    function target string;
        return this.original-target

    function path string;
        return this.original-path

    function route-pattern string;
        return this.pattern

    function http-version string;
        return this.version

    function scheme string|none;
        return this.origin-scheme

    function authority string|none;
        return this.origin-authority

    function url string|none;
        scheme = this.origin-scheme
        authority = this.origin-authority
        if scheme != none and authority != none
            return scheme + '://' + authority + this.original-target
        return none

    function peer-ip string|none;
        peer = this.peer
        if peer != none
            return address-text; peer
        return none

    function client-ip string|none;
        client = this.client
        if client != none
            return address-text; client
        return none

    function via-trusted-proxy bool;
        return this.trusted

    function header-bytes list of bytes; name string
        return read-header-bytes; this.headers, name

    function header-values list of string; name string
        return read-header-values; this.headers, name

    function header-value string|none; name string
        return read-header-value; this.headers, name

    function header-byte-count int;
        return count-header-bytes; this.headers

    function cookie-value string|none; name string
        for header in (this.header-values; 'cookie')
            for pair in (header.split; ';')
                trimmed = pair.trim;
                parts = trimmed.split; '='
                if parts.length >= 2 and parts[0] == name
                    return trimmed.trim.start; (name + '=')
        return none

# Framework capture factory; application handlers receive only the read-only snapshot.
public function capture-request-context request-context; request ref native-request, route-pattern string
    return instance request-context; request, route-pattern

private function request-method string; request ref native-request
    return (request.method;).as_str;

private function address-text string; address ip-addr
    # Projection does not expose Display formatting for this native IpAddr.
    return rust
        address.to_string()

private function request-target string; request ref native-request
    target string|none = request.extensions;
        .get of original-uri;
        .map; original-uri-target
    if target != none
        return move target
    current string|none = (request.uri;).path_and_query;
        .map; path-and-query-text
    if current != none
        return move current
    return '/'

private function original-uri-target string; original ref original-uri
    target string|none = (original.n0).path_and_query;
        .map; path-and-query-text
    if target != none
        return move target
    return '/'

private function path-and-query-text string; path-and-query ref native-path-and-query
    return path-and-query.as_str;

private function request-path string; request ref native-request
    path string|none = request.extensions;
        .get of original-uri;
        .map; original-uri-path
    if path != none
        return move path
    return (request.uri;).path;

private function original-uri-path string; original ref original-uri
    return (original.n0).path;

private function request-route-pattern string; request ref native-request, fallback string
    matched string|none = request.extensions;
        .get of matched-path;
        .map; matched-path-text
    if matched != none
        return matched
    return fallback

private function matched-path-text string; value ref matched-path
    return value.as_str;

private function request-version string; request ref native-request
    # Preserve the native Debug spelling until projected Version formatting is available.
    value string = rust
        format!("{:?}", request.version())
    return value

private function request-authority string|none; request ref native-request
    authority string|none = (request.uri;).authority;
        .map; authority-text
    if authority != none
        return move authority
    return (request.headers;).get; 'host'
        .and_then; decode-host

private function authority-text string; authority ref native-authority
    return authority.as_str;

private function decode-host string|none; value ref native-header-value
    try
        return value.to_str;
    catch header-text-error
        return none

private function request-proxy-trust bool; request ref native-request
    return request-proxy-metadata-trusted; request

# Retain native header values; only materialize the requested accessor result.
# Borrow the native map under the shared handle's short-lived guard, not a clone.
# A source `ref` to this shared native value currently lowers to Weak, not &HeaderMap.
private function read-header-bytes list of bytes; headers shared ref (native-header-map of native-header-value), name ref string
    # Projected iteration must materialize an ordered list of owned bytes under one guard.
    values list of bytes = rust
        let headers = headers.lock().expect("shared reference lock poisoned");
        terrane_collection_support::List::new(headers.get_all(name.as_str()).iter().map(|value| value.as_bytes().to_vec()).collect())
    return values

private function read-header-values list of string; headers shared ref (native-header-map of native-header-value), name ref string
    # Accept UTF-8, not HeaderValue::to_str's narrower visible-ASCII subset;
    # validate borrowed bytes and allocate only for successful entries.
    values list of string = rust
        let headers = headers.lock().expect("shared reference lock poisoned");
        terrane_collection_support::List::new(headers.get_all(name.as_str()).iter().filter_map(|value| std::str::from_utf8(value.as_bytes()).ok().map(str::to_owned)).collect())
    return values

private function read-header-value string|none; headers shared ref (native-header-map of native-header-value), name ref string
    return ((headers.get_all; name).iter;).find_map; decode-header-text

private function decode-header-text string|none; header ref native-header-value
    try
        return (header.as_bytes;).decode; utf8
    catch decode-error
        return none

# Split only outside quoted Forwarded parameter values. Unsupported quoted-pair
# escapes fail closed rather than treating their punctuation as trusted metadata.
private function forwarded-parts (list of string)|none; value string, separator string
    quoted = value.split; '"'
    if quoted.length % 2 == 0
        return none
    result list of string = list
    current string = ''
    in-quotes bool = false
    for part in quoted
        if in-quotes
            if part.contains; '\\'
                return none
            current = current + '"' + part + '"'
        else
            pieces = part.split; separator
            index int = 0
            while index < pieces.length
                current = current + pieces[index]
                if index + 1 < pieces.length
                    result.append; current
                    current = ''
                index = index + 1
        in-quotes = not in-quotes
    result.append; current
    return result

private function forwarded-scheme string|none; context request-context
    headers = context.header-values; 'forwarded'
    standard = context.header-bytes; 'forwarded'
    if standard.length > 0
        if headers.length != standard.length
            return none
        combined string = ''
        for header in headers
            if combined != ''
                combined = combined + ','
            combined = combined + header
        entries = forwarded-parts; combined, ','
        if entries != none
            last = entries[entries.length - 1]
            result string|none = none
            pairs = forwarded-parts; last, ';'
            if pairs != none
                for pair in pairs
                    parts = pair.split; '='
                    if parts.length == 2 and ((parts[0].trim;).lower;) == 'proto'
                        if result != none
                            return none
                        value = (parts[1].trim;).lower;
                        if value == 'http' or value == '"http"'
                            result = 'http'
                        else if value == 'https' or value == '"https"'
                            result = 'https'
                        else
                            return none
                return result
        return none
    headers = context.header-values; 'x-forwarded-proto'
    raw = context.header-bytes; 'x-forwarded-proto'
    if headers.length != raw.length or headers.length == 0
        return none
    legacy-entries = headers[headers.length - 1].split; ','
    value = ((legacy-entries[legacy-entries.length - 1].trim;).lower;)
    if value == 'http' or value == 'https'
        return value
    return none

private function count-header-bytes int; headers shared ref (native-header-map of native-header-value)
    # Count borrowed header bytes in place, including repetitions, without snapshots.
    result int = rust
        let headers = headers.lock().expect("shared reference lock poisoned");
        let count = headers.iter().fold(0usize, |total, (name, value)| {
            total.saturating_add(name.as_str().len()).saturating_add(value.as_bytes().len())
        });
        (count as i128).into()
    return result
